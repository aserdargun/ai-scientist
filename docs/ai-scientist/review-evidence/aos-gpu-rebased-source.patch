+                ErrorCode.UNSAFE_ACTION, "Lab suite is outside the configured AOS allowlist"
+            )
+        existing = self.connection.execute(
+            "SELECT * FROM aos_external_jobs WHERE session_id=? AND idempotency_key=?",
+            (session_id, request.idempotency_key),
+        ).fetchone()
+        if existing is None:
+            job_id = identifier("external-job")
+            task_id = identifier("task")
+            run_id = identifier("run")
+            action_id = identifier("action")
+            step_id = identifier("step")
+        else:
+            job_id = existing["job_id"]
+            task_id = existing["task_id"]
+            run_id = existing["run_id"]
+            action_id = existing["action_id"]
+            step_id = existing["step_id"]
+        remote_idempotency_key = (
+            "aos-"
+            + hashlib.sha256(
+                f"{session_id}\0{task_id}\0{run_id}\0{action_id}\0{request.idempotency_key}".encode()
+            ).hexdigest()
+        )
