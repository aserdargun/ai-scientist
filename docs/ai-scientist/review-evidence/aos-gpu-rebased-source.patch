+    def _validate_pending_start(
+        self, row, session_id: str, request: AOSLabStartRequest, request_sha: str
+    ) -> None:
+        """Fence a retry of an unacknowledged POST to its original authority."""
+        desktop = self.controller.state()
+        binding = self.connection.execute(
+            "SELECT session_id,lease_id,generation FROM aos_external_job_bindings WHERE job_id=?",
+            (row["job_id"],),
+        ).fetchone()
+        if (
+            binding is None
+            or binding["session_id"] != session_id
+            or binding["session_id"] != self.controller.session_id
+            or binding["lease_id"] != request.lease_id
+            or binding["generation"] != request.generation
+            or desktop.get("owner") != "HUMAN"
+            or desktop.get("status") != "running"
+            or desktop.get("lease_id") != request.lease_id
+            or desktop.get("generation") != request.generation
+            or row["state"] != "dispatch_pending"
+            or row["request_sha256"] != request_sha
+        ):
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Pending Lab dispatch lost its original authority")
+        state_row = self.connection.execute(
+            "SELECT state_json FROM runtime_states WHERE run_id=?", (row["run_id"],)
+        ).fetchone()
+        action_row = self.connection.execute(
+            "SELECT a.*,e.envelope_json,e.payload_sha256 FROM actions a "
+            "JOIN action_envelopes e USING(action_id) WHERE a.action_id=?",
+            (row["action_id"],),
+        ).fetchone()
+        if state_row is None or action_row is None or action_row["status"] != "intent":
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Pending Lab dispatch has no durable intent")
+        state = State.model_validate_json(state_row["state_json"], strict=True)
+        action = Action.model_validate_json(action_row["envelope_json"], strict=True)
+        if (
+            state.task_kind != "ai_scientist"
+            or state.phase != Phase.EXECUTE
+            or state.owner != "AGENT"
+            or state.task_id != row["task_id"]
+            or state.run_id != row["run_id"]
+            or action.action_id != row["action_id"]
+            or action.tool != "lab.start"
+            or action.task_id != state.task_id
+            or action.run_id != state.run_id
+            or action.arguments.get("job_id") != row["job_id"]
+            or action.arguments.get("request_sha256") != request_sha
+            or action.selected_option != "start"
+            or action_row["payload_sha256"] != digest(action.model_dump(mode="json"))
+        ):
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Pending Lab dispatch intent failed verification")
+        self._validate_lab_action(action, state)
+
+    async def _apply_observation(self, job_id: str, remote: LabRunStatus):
+        state = (
+            "stop_requested"
+            if remote.stop_requested and remote.state in {"queued", "running"}
+            else remote.state
+        )
+        report = None
+        report_sha = None
+        if state in {"completed", "stopped", "failed"}:
+            report = await asyncio.to_thread(self.client.report, remote.run_id)
+            if report.report.get("status") != state:
+                raise RuntimeError("Lab terminal report status differs from run status")
+            if report.report.get("run_id") != str(remote.run_id):
+                raise RuntimeError("Lab terminal report body belongs to another run")
+            if remote.report_sha256 is None or remote.report_sha256 != report.report_sha256:
+                raise RuntimeError("Lab status receipt differs from verified report hash")
+            report_sha = report.report_sha256
+        with self.connection:
+            current = self.connection.execute(
+                "SELECT * FROM aos_external_jobs WHERE job_id=?", (job_id,)
+            ).fetchone()
+            if current is None or current["lab_run_id"] not in {None, str(remote.run_id)}:
+                raise RuntimeError("AOS external job changed Lab run identity")
+            current_state = current["state"]
+            terminal = {"completed", "stopped", "failed"}
+            if current_state in terminal:
+                if state not in terminal:
+                    # A delayed nonterminal response must never roll back an
+                    # independently verified terminal result.
+                    return current
+                if state != current_state or report_sha != current["report_sha256"]:
+                    raise RuntimeError("Lab terminal observation conflicts with verified AOS state")
+                return current
+            merged = self._monotonic_state(current_state, state)
+            effective_sha = report_sha if merged == state else current["report_sha256"]
+            effective_lab_state = merged
+            self.connection.execute(
+                "UPDATE aos_external_jobs SET lab_run_id=?,state=?,lab_state=?,"
+                "report_sha256=?,updated_at=? "
+                "WHERE job_id=?",
+                (str(remote.run_id), merged, effective_lab_state, effective_sha, now(), job_id),
+            )
+            if merged != current_state or effective_sha != current["report_sha256"]:
+                self._event(
+                    job_id,
+                    "report_verified" if effective_sha else "status_observed",
+                    {"lab_state": effective_lab_state, "report_sha256": effective_sha},
+                )
+            updated = self.connection.execute(
+                "SELECT * FROM aos_external_jobs WHERE job_id=?", (job_id,)
+            ).fetchone()
+            if report is not None and merged == state:
+                await self._record_verified_terminal(updated, report)
+            return updated
+
+    @staticmethod
+    def _monotonic_state(current: str, incoming: str) -> str:
+        ranks = {
+            "dispatch_pending": 0,
+            "queued": 1,
+            "running": 2,
+            "stop_requested": 3,
+            "completed": 4,
+            "stopped": 4,
+            "failed": 4,
+        }
+        if incoming not in ranks or current not in ranks:
+            raise RuntimeError("Unknown Lab external job state")
+        return incoming if ranks[incoming] > ranks[current] else current
+
+    async def status(self, session_id: str, job_id: str) -> dict[str, object]:
+        row = self._owned(session_id, job_id)
+        if not row["lab_run_id"]:
+            return self._public(row)
+        if row["state"] in {"completed", "stopped", "failed"}:
+            return self._public(row)
+        action_id = await self._record_control_action(row, "status")
+        run_id = UUID(row["lab_run_id"])
+        remote = await asyncio.to_thread(self.client.status, run_id)
+        if remote.run_id != run_id:
+            raise RuntimeError("Lab returned another run identity")
+        updated = await self._apply_observation(job_id, remote)
+        self._finish_control_action(action_id, {"lab_run_id": str(run_id), "state": remote.state})
+        return self._public(updated)
+
+    async def stop(
+        self, session_id: str, job_id: str, lease_id: str, generation: int
+    ) -> dict[str, object]:
+        self._check_lease(lease_id, generation)
+        row = self._owned(session_id, job_id)
+        if not row["lab_run_id"]:
+            raise AOSFault(
+                ErrorCode.UNSAFE_ACTION, "Lab dispatch has no acknowledged run handle yet"
+            )
+        run_id = UUID(row["lab_run_id"])
+        stop_action_id = await self._record_control_action(
+            row,
+            "stop",
+            idempotency_key=f"lab-stop:{job_id}",
+            require_human_lease=True,
+        )
+        recorded = self.connection.execute(
+            "SELECT status FROM actions WHERE action_id=?", (stop_action_id,)
+        ).fetchone()
+        if recorded is not None and recorded["status"] == "ok":
+            return self._public(row)
+        remote = await asyncio.to_thread(self.client.stop, run_id)
+        if remote.run_id != run_id:
+            raise RuntimeError("Lab stop response belongs to another run")
+        observed = await self._apply_observation(job_id, remote)
+        self._finish_control_action(
+            stop_action_id, {"lab_run_id": str(run_id), "state": observed["state"]}
+        )
+        with self.connection:
+            self._event(job_id, "stop_requested", {"lab_state": observed["state"]})
+        return self._public(observed)
+
+    async def stop_for_desktop_takeover(self, session_id: str) -> None:
+        """Request bounded stop for this session's detached jobs before ownership changes."""
+        rows = self.connection.execute(
+            "SELECT j.* FROM aos_external_jobs j JOIN aos_external_job_bindings b USING(job_id) "
+            "WHERE b.session_id=? AND j.state IN ('dispatch_pending','queued','running','stop_requested') "
+            "ORDER BY j.created_at LIMIT 9",
+            (session_id,),
+        ).fetchall()
+        if len(rows) > 8:
+            with self.connection:
+                self._event(
+                    rows[0]["job_id"],
+                    "dispatch_error",
+                    {"operation": "desktop_takeover_stop", "error_type": "active_job_limit"},
+                )
+        for row in rows:
+            if len(rows) <= 8:
+                with self.connection:
+                    self._event(
+                        row["job_id"],
+                        "stop_requested",
+                        {
+                            "reason": "desktop_takeover",
+                            "phase": "intent",
+                            "lab_run_id": row["lab_run_id"],
+                        },
+                    )
+            if len(rows) > 8:
+                with self.connection:
+                    self._event(
+                        row["job_id"],
+                        "dispatch_error",
+                        {"operation": "desktop_takeover_stop", "error_type": "active_job_limit"},
+                    )
+                self._pause_typed_run(row["run_id"])
+                continue
+            if not row["lab_run_id"]:
+                with self.connection:
+                    self._event(
+                        row["job_id"],
+                        "dispatch_error",
+                        {"operation": "desktop_takeover_stop", "error_type": "missing_lab_handle"},
+                    )
+                self._pause_typed_run(row["run_id"])
+                continue
+            await self._perform_takeover_stop(row)
+            self._pause_typed_run(row["run_id"])
+
+    def _pause_typed_run(self, run_id: str) -> None:
+        stored = self.connection.execute(
+            "SELECT state_json FROM runtime_states WHERE run_id=?", (run_id,)
+        ).fetchone()
+        run = self.connection.execute("SELECT status FROM runs WHERE run_id=?", (run_id,)).fetchone()
+        if stored is None or run is None or run["status"] != "running":
+            return
+        state = State.model_validate_json(stored["state_json"], strict=True)
+        if state.task_kind != "ai_scientist" or state.phase != Phase.EXECUTE or state.owner != "AGENT":
+            return
+        paused = state.model_copy(
+            update={
+                "phase": Phase.PAUSED,
+                "owner": "PAUSED",
+                "owner_lease_id": identifier("revoked"),
+                "state_version": state.state_version + 1,
+            }
+        )
+        timestamp = now()
+        with self.connection:
+            changed_run = self.connection.execute(
+                "UPDATE runs SET status='paused',outcome='unknown' WHERE run_id=? AND status='running'",
+                (run_id,),
+            ).rowcount
+            changed_state = self.connection.execute(
+                "UPDATE runtime_states SET state_version=?,state_json=? WHERE run_id=? AND state_version=?",
+                (paused.state_version, paused.model_dump_json(), run_id, state.state_version),
+            ).rowcount
+            if changed_run != 1 or changed_state != 1:
+                raise AOSFault(ErrorCode.UI_CHANGED, "Lab typed state changed during desktop takeover")
+            self.connection.execute(
+                "UPDATE steps SET state='PAUSED' WHERE step_id=? AND ended_at IS NULL",
+                (paused.step_id,),
+            )
+            self.connection.execute(
+                "INSERT INTO state_snapshots(snapshot_id,run_id,step_id,state_version,state_json,content_sha256,created_at) "
+                "VALUES(?,?,?,?,?,?,?)",
+                (
+                    identifier("snapshot"),
+                    paused.run_id,
+                    paused.step_id,
+                    paused.state_version,
+                    paused.model_dump_json(),
+                    digest(paused.model_dump(mode="json")),
+                    timestamp,
+                ),
+            )
+
+    def _desktop_takeover_stop_pending(self, job_id: str) -> bool:
+        event = self.connection.execute(
+            "SELECT event_json FROM aos_external_job_events WHERE job_id=? "
+            "AND event_type='stop_requested' ORDER BY rowid DESC LIMIT 1",
+            (job_id,),
+        ).fetchone()
+        if event is None:
+            return False
+        try:
+            payload = json.loads(event["event_json"])
+        except (TypeError, json.JSONDecodeError):
+            return False
+        return payload.get("reason") == "desktop_takeover" and payload.get("phase") != "acknowledged"
+
+    async def _perform_takeover_stop(self, row) -> None:
+        if not row["lab_run_id"] or row["state"] in {"completed", "stopped", "failed"}:
+            return
+        try:
+            action_id = await self._record_control_action(
+                row,
+                "stop",
+                idempotency_key=f"lab-stop:{row['job_id']}",
+            )
+            action = self.connection.execute(
+                "SELECT status FROM actions WHERE action_id=?", (action_id,)
+            ).fetchone()
+            if action is not None and action["status"] == "ok":
+                with self.connection:
+                    self._event(
+                        row["job_id"],
+                        "stop_requested",
+                        {"reason": "desktop_takeover", "phase": "acknowledged", "lab_state": row["state"]},
+                    )
+                return
+            run_id = UUID(row["lab_run_id"])
+            remote = await asyncio.to_thread(self.client.stop, run_id)
+            if remote.run_id != run_id:
+                raise RuntimeError("Lab takeover stop response belongs to another run")
+            observed = await self._apply_observation(row["job_id"], remote)
+            self._finish_control_action(
+                action_id, {"lab_run_id": str(run_id), "state": observed["state"]}
+            )
+            with self.connection:
+                self._event(
+                    row["job_id"],
+                    "stop_requested",
+                    {"reason": "desktop_takeover", "phase": "acknowledged", "lab_state": observed["state"]},
+                )
+        except (OSError, RuntimeError, ValueError, TypeError, AOSFault) as error:
+            with self.connection:
+                self._event(
+                    row["job_id"],
+                    "dispatch_error",
+                    {"operation": "desktop_takeover_stop", "error_type": type(error).__name__},
+                )
+
+    def recover(
+        self,
+        session_id: str,
+        job_id: str,
+        lease_id: str,
+        generation: int,
+    ) -> dict[str, object]:
+        """Explicitly rebind a paused detached job; never submits a new Lab start."""
+        self._check_lease(lease_id, generation)
+        if session_id != self.controller.session_id:
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab recovery session is not current")
+        row = self.connection.execute(
+            "SELECT j.*,b.session_id AS bound_session,b.lease_id AS bound_lease,"
+            "b.generation AS bound_generation FROM aos_external_jobs j "
+            "JOIN aos_external_job_bindings b USING(job_id) WHERE j.job_id=?",
+            (job_id,),
+        ).fetchone()
+        if row is None:
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Unknown AOS Lab job")
+        if (
+            row["bound_session"] == session_id
+            and row["bound_lease"] == lease_id
+            and row["bound_generation"] == generation
+        ):
+            if row["state"] not in {"dispatch_pending", "queued", "running", "stop_requested"}:
+                raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab job is terminal and cannot be rebound")
+            run = self.connection.execute(
+                "SELECT status FROM runs WHERE run_id=?", (row["run_id"],)
+            ).fetchone()
+            state_row = self.connection.execute(
+                "SELECT state_json FROM runtime_states WHERE run_id=?", (row["run_id"],)
+            ).fetchone()
+            if run is not None and run["status"] == "running" and state_row is not None:
+                current = State.model_validate_json(state_row["state_json"], strict=True)
+                if current.phase == Phase.EXECUTE and current.owner == "AGENT":
+                    return self._public(row)
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Current Lab binding is not an active resumable job")
+        if row["state"] not in {"queued", "running", "stop_requested"} or not row["lab_run_id"]:
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Only acknowledged active Lab jobs can be rebound")
+        state_row = self.connection.execute(
+            "SELECT state_json FROM runtime_states WHERE run_id=?", (row["run_id"],)
+        ).fetchone()
+        run_row = self.connection.execute(
+            "SELECT status FROM runs WHERE run_id=?", (row["run_id"],)
+        ).fetchone()
+        if state_row is None or run_row is None or run_row["status"] != "paused":
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab takeover requires a paused AOS trajectory")
+        paused = State.model_validate_json(state_row["state_json"], strict=True)
+        try:
