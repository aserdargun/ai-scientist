+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import sqlite3
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from uuid import uuid4
+
+import pytest
+from aos.contracts import AOSFault
+from aos.computer import SafetyPolicy
+from aos.contracts import Action, Option, Phase, Prediction, State
+from aos.lab_external import (
+    AOSLabStartRequest,
+    LabExternalJobCoordinator,
+    LabRunHandle,
+    LabRunStatus,
+    LabVerifiedReport,
+)
+
+
+class DenyDecisionEngine:
+    identity = {"deployment_id": "fixture-deny-v1", "kind": "deterministic_fixture", "real_model": False}
+
+    async def decide(self, state, options):
+        del state
+        return Prediction(
+            selected_option="deny",
+            probabilities={option.id: 1.0 if option.id == "deny" else 0.0 for option in options},
+        )
+
+
+class FakeController:
+    def __init__(self):
+        self.owner_thread = threading.get_ident()
+        self.session_id = "session-a"
+        self.current = {
+            "status": "running",
+            "owner": "HUMAN",
+            "lease_id": "lease-current",
+            "generation": 3,
+            "runtime_id": "runtime",
+        }
+
+    def state(self):
+        assert threading.get_ident() == self.owner_thread
+        return dict(self.current)
+
+    def control(self, command):
+        if command in {"pause", "take-control", "stop", "restart"}:
+            self.current.update(owner="PAUSED", status="paused", lease_id="lease-revoked")
+            self.current["generation"] += 1
+        if command == "take-control":
+            self.current.update(owner="HUMAN", status="running", lease_id="lease-new")
+        return self.state()
+
+
+class FakeLabClient:
+    def __init__(self):
+        self.start_calls = []
+        self.run_id = uuid4()
+        self.state = "queued"
+        self.report_document = None
+        self.fail_start_after_recording = False
+        self.fail_stop = False
+
+    def start(self, request):
+        self.start_calls.append(request)
+        if self.fail_start_after_recording:
+            raise OSError("simulated lost start acknowledgement")
+        if len(self.start_calls) > 1:
+            self.run_id = uuid4()
+        return LabRunHandle(run_id=self.run_id, state=self.state, reused=len(self.start_calls) > 1)
+
+    def status(self, run_id):
+        assert run_id == self.run_id
+        report_sha256 = None
+        if self.report_document is not None:
+            report_sha256 = self.report_document.report_sha256
+        return LabRunStatus(
+            run_id=run_id,
+            origin="aos",
+            state=self.state,
+            created_at="2026-09-24T00:00:00Z",
+            updated_at="2026-09-24T00:01:00Z",
+            stop_requested=self.state == "stop_requested",
+            report_sha256=report_sha256,
+        )
+
+    def stop(self, run_id):
+        assert run_id == self.run_id
+        if self.fail_stop:
+            raise OSError("simulated Lab outage")
+        self.state = "stop_requested"
+        return self.status(run_id)
+
+    def report(self, run_id):
+        assert run_id == self.run_id and self.report_document is not None
+        return self.report_document
+
+
+def _database(path=":memory:"):
+    connection = sqlite3.connect(path)
+    connection.row_factory = sqlite3.Row
+    connection.execute("PRAGMA foreign_keys=ON")
+    migrations = Path(__file__).resolve().parents[1] / "database/migrations"
+    for migration in sorted(migrations.glob("*.sql")):
+        connection.executescript(migration.read_text(encoding="utf-8"))
+    created = "2026-09-24T00:00:00Z"
+    for session_id in ("session-a", "session-b"):
+        connection.execute(
+            "INSERT INTO desktop_sessions VALUES(?,?,?,?,?,?,?,?,?)",
+            (
+                session_id,
+                "runtime",
+                "image",
+                "HUMAN",
+                "lease-current",
+                3,
+                "running",
+                created,
+                created,
+            ),
+        )
+    return connection
+
+
+def _request(**changes):
+    values = {
+        "lease_id": "lease-current",
+        "generation": 3,
+        "idempotency_key": "job-key-0123456789abcdef",
+        "suite": "synthetic.allowed.v1",
+        "experiments": 20,
+        "wall_seconds": 14_400,
+        "model_tokens": 350_000,
+    }
+    values.update(changes)
+    return AOSLabStartRequest.model_validate(values, strict=True)
+
+
+def test_external_start_is_lease_bound_durable_and_does_not_need_scheduler():
+    db, controller, lab = _database(), FakeController(), FakeLabClient()
+    coordinator = LabExternalJobCoordinator(
+        db, controller, lab, allowed_suites=frozenset({"synthetic.allowed.v1"})
+    )
+    first = asyncio.run(coordinator.start("session-a", _request()))
+    repeated = asyncio.run(coordinator.start("session-a", _request()))
+    assert first == repeated
+    assert first["state"] == "queued"
+    assert first["lab_run_id"] == str(lab.run_id)
+    assert first["aos_run_id"] and first["aos_action_id"] and first["task_id"]
+    assert len(lab.start_calls) == 1
+    assert db.execute("SELECT count(*) FROM aos_external_job_events").fetchone()[0] == 3
+    assert db.execute("SELECT count(*) FROM tasks").fetchone()[0] == 1
+    assert db.execute("SELECT count(*) FROM runs WHERE status='running'").fetchone()[0] == 1
+    assert db.execute("SELECT tool FROM actions").fetchone()[0] == "lab.start"
+    assert lab.start_calls[0].idempotency_key != _request().idempotency_key
+    stored_state = State.model_validate_json(
+        db.execute("SELECT state_json FROM runtime_states").fetchone()[0]
+    )
+    assert stored_state.task_kind == "ai_scientist"
+    assert stored_state.phase == Phase.EXECUTE
+    assert db.execute("SELECT count(*) FROM state_snapshots").fetchone()[0] >= 2
+    assert db.execute(
+        "SELECT count(*) FROM actions a JOIN decisions d USING(decision_id) "
+        "JOIN action_envelopes e USING(action_id) WHERE a.tool LIKE 'lab.%' "
+        "AND d.policy_result='allow'"
+    ).fetchone()[0] >= 2
+
+
+def test_remote_idempotency_is_namespaced_per_aos_session():
+    db, controller, lab = _database(), FakeController(), FakeLabClient()
+    coordinator = LabExternalJobCoordinator(
