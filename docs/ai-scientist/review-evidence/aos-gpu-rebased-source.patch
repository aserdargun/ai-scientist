+"""Opt-in AOS bridge for detached, typed Lab research jobs.
+
+This module is intentionally separate from DesktopScheduler: research runs are
+durable external jobs and never occupy its single foreground task slot.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import http.client
+import ipaddress
+import json
+import os
+import stat
+import time
+from pathlib import Path
+from typing import Literal
+from urllib.parse import urlsplit
+from uuid import UUID, uuid4
+
+from pydantic import BaseModel, ConfigDict, Field, StrictInt, StrictStr
+
+from .computer import SafetyPolicy, ToolRegistry
+from .contracts import (
+    AOSFault,
+    Action,
+    ErrorCode,
+    Option,
+    Phase,
+    Prediction,
+    State,
+    canonical,
+    digest,
+    identifier,
+    now,
+)
+from .decision import FixtureDecisionEngine, decision_request
+
+
+class LabBudget(BaseModel):
+    model_config = ConfigDict(strict=True, extra="forbid", frozen=True)
+
+    experiments: StrictInt = Field(ge=1, le=35)
+    wall_seconds: StrictInt = Field(ge=1, le=14_400)
+    model_tokens: StrictInt = Field(ge=0, le=350_000)
+
+
+class LabStartRequest(BaseModel):
+    model_config = ConfigDict(strict=True, extra="forbid", frozen=True)
+
+    idempotency_key: StrictStr = Field(min_length=16, max_length=128)
+    track: Literal["anomaly"] = "anomaly"
+    suite: StrictStr = Field(min_length=1, max_length=128)
