+def test_lab_http_wire_uses_strict_json_representations(tmp_path):
+    run_id = uuid4()
+    report = {"run_id": str(run_id), "status": "completed", "scores": []}
+    report_sha = hashlib.sha256(
+        json.dumps(report, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
+    ).hexdigest()
+    requests = []
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_POST(self):
+            length = int(self.headers.get("Content-Length", "0"))
+            requests.append(
+                (
+                    self.command,
+                    self.path,
+                    self.headers.get("Authorization"),
+                    self.rfile.read(length),
+                )
+            )
+            if self.path == "/v1/runs":
+                value = {"run_id": str(run_id), "state": "queued", "reused": False}
+                status = 202
+            else:
+                value = {
+                    "run_id": str(run_id),
+                    "origin": "aos",
+                    "state": "stop_requested",
+                    "created_at": "2026-09-24T00:00:00Z",
+                    "updated_at": "2026-09-24T00:01:00Z",
+                    "stop_requested": True,
+                    "report_sha256": None,
+                }
+                status = 200
+            body = json.dumps(value).encode()
+            self.send_response(status)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def do_GET(self):
+            requests.append((self.command, self.path, self.headers.get("Authorization"), b""))
+            if self.path.endswith("/report"):
+                value = {
+                    "run_id": str(run_id),
+                    "report_sha256": report_sha,
+                    "report": report,
+                    "verified_at": "2026-09-24T00:02:00Z",
+                }
+            else:
+                value = {
+                    "run_id": str(run_id),
+                    "origin": "aos",
+                    "state": "running",
+                    "created_at": "2026-09-24T00:00:00Z",
+                    "updated_at": "2026-09-24T00:01:00Z",
+                    "stop_requested": False,
+                    "report_sha256": None,
+                }
+            body = json.dumps(value).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, *_args):
+            return
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    token_file = tmp_path / "token"
+    token_file.write_text("private-token\n", encoding="utf-8")
+    token_file.chmod(0o600)
+    from aos.lab_external import LabApiClient, LabStartRequest
+
+    client = LabApiClient(f"http://127.0.0.1:{server.server_port}", token_file)
+    start = LabStartRequest(
+        idempotency_key="wire-key-0123456789",
+        suite="synthetic.allowed.v1",
+        budget={"experiments": 2, "wall_seconds": 30, "model_tokens": 100},
+        external_task_id="task-" + "1" * 32,
+        external_run_id="run-" + "2" * 32,
+        external_action_id="action-" + "3" * 32,
+    )
+    try:
+        assert client.start(start).run_id == run_id
+        assert client.status(run_id).run_id == run_id
+        assert client.stop(run_id).run_id == run_id
+        assert client.report(run_id).run_id == run_id
+    finally:
+        server.shutdown()
+        thread.join(timeout=2)
+        server.server_close()
+    assert len(requests) == 4
+    assert all(row[2] == "Bearer private-token" for row in requests)
+    assert requests[0][3] and json.loads(requests[0][3])["idempotency_key"] == start.idempotency_key
+
