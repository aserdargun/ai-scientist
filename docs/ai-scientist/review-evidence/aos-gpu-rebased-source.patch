+"""Fail-closed AOS client for the Lab-owned shared GPU turn broker.
+
+This module does not implement arbitration or own runtime-drain authority. The
+Lab broker must authenticate the peer, use the canonical shared scheduler,
+launch a fixed model profile, and verify systemd/cgroup/GPU drain itself.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+from pathlib import Path
+import re
+import socket
+import stat
+import struct
+import subprocess  # nosec B404 -- fixed systemctl query for the trusted broker unit
+import time
+from typing import Literal
+from uuid import uuid4
+
+from pydantic import Field, ValidationError
+
+from .contracts import AOSFault, ErrorCode, TypedModel, canonical
+
+
+_MAX_FRAME_BYTES = 128 * 1024
+_BROKER_UNIT = "swapp-lab-gpu-broker.service"
+_SYSTEMCTL = "/usr/bin/systemctl"
+_PROFILE_IDS = frozenset({
+    "aos.decider.turn.v1",
+    "aos.bonsai.recovery.v1",
+    "aos.bonsai.vision.v1",
+})
+
+
+class GpuRuntimeGeneration(TypedModel):
+    unit: str = Field(pattern=r"^swapp-aos-gpu-turn-[a-f0-9]{32}\.service$")
+    invocation_id: str = Field(pattern=r"^[a-f0-9]{32}$")
+    main_pid: int = Field(gt=0)
+    control_group: str = Field(min_length=1, max_length=512)
+
+
+class GpuInferenceResult(TypedModel):
+    version: Literal[1]
+    request_id: str = Field(pattern=r"^[a-f0-9]{32}$")
+    profile_id: Literal[
+        "aos.decider.turn.v1",
+        "aos.bonsai.recovery.v1",
+        "aos.bonsai.vision.v1",
+    ]
+    deployment_digest: str = Field(pattern=r"^[a-f0-9]{64}$")
+    generation: GpuRuntimeGeneration
+    response: dict
+    usage: dict
+
+
+class _WireReceipt(TypedModel):
+    version: Literal[1]
+    request_id: str = Field(pattern=r"^[a-f0-9]{32}$")
+    profile_id: Literal[
+        "aos.decider.turn.v1",
+        "aos.bonsai.recovery.v1",
+        "aos.bonsai.vision.v1",
+    ]
+    deployment_digest: str = Field(pattern=r"^[a-f0-9]{64}$")
+    generation: GpuRuntimeGeneration
+    response: dict
+    usage: dict
+
+
+def _process_start_ticks(pid: int) -> int:
+    fields = Path(f"/proc/{pid}/stat").read_text(encoding="ascii").rsplit(")", 1)[1].split()
+    return int(fields[19])
+
+
+def _process_cgroup(pid: int) -> str:
+    for line in Path(f"/proc/{pid}/cgroup").read_text(encoding="ascii").splitlines():
+        _, _, path = line.partition(":")
+        _, _, path = path.partition(":")
+        if path.startswith("/"):
+            return path.rstrip("/")
+    raise OSError("broker process cgroup is unavailable")
+
+
+class AOSGpuTurnClient:
+    """Call a fixed local broker; caller cannot select owner, command or limits."""
+
+    def __init__(self, socket_path: Path, *, timeout_seconds: int = 720) -> None:
+        if type(timeout_seconds) is not int or not 1 <= timeout_seconds <= 720:
+            raise ValueError("GPU broker call timeout must be bounded to 1..720 seconds")
+        self.socket_path = socket_path
+        self.timeout_seconds = timeout_seconds
+
+    def _verify_socket(self) -> None:
+        parent = self.socket_path.parent
+        parent_info = parent.lstat()
+        socket_info = self.socket_path.lstat()
+        if (
+            parent.is_symlink()
+            or not parent.is_dir()
+            or parent_info.st_uid != os.getuid()
+            or parent_info.st_mode & 0o077
+            or self.socket_path.is_symlink()
+            or not stat.S_ISSOCK(socket_info.st_mode)
+            or socket_info.st_uid != os.getuid()
+            or socket_info.st_mode & 0o077
+        ):
+            raise AOSFault(ErrorCode.MODEL_FAILURE, "Shared GPU broker socket is not private")
+
+    @staticmethod
+    def _verify_broker_peer(peer_pid: int, peer_uid: int) -> None:
+        if peer_uid != os.getuid() or peer_pid <= 1:
+            raise AOSFault(ErrorCode.MODEL_FAILURE, "Shared GPU broker peer identity differs")
+        try:
+            start_ticks = _process_start_ticks(peer_pid)
+            cgroup = _process_cgroup(peer_pid)
+            runtime_dir = Path(os.environ.get("XDG_RUNTIME_DIR", ""))
+            expected_runtime_dir = Path("/run/user") / str(os.getuid())
+            if (
+                runtime_dir != expected_runtime_dir
+                or runtime_dir.is_symlink()
+                or not runtime_dir.is_dir()
+                or runtime_dir.stat().st_uid != os.getuid()
+            ):
+                raise ValueError("user runtime directory is not the current user's directory")
+            expected_bus_path = str(runtime_dir / "bus")
+            bus_address = os.environ.get("DBUS_SESSION_BUS_ADDRESS", "")
+            if re.fullmatch(
+                rf"unix:path={re.escape(expected_bus_path)}(?:,guid=[0-9a-f]{{32}})?",
+                bus_address,
+            ) is None:
+                raise ValueError("user bus address is not the current runtime bus")
+            result = subprocess.run(
+                [
+                    _SYSTEMCTL,
+                    "--user",
+                    "show",
+                    _BROKER_UNIT,
+                    "--property=LoadState,ActiveState,MainPID,InvocationID,ControlGroup",
+                    "--no-pager",
+                ],
+                capture_output=True,
+                text=True,
+                timeout=2,
+                check=False,
+                env={
+                    "PATH": "/usr/bin:/bin",
+                    "XDG_RUNTIME_DIR": str(runtime_dir),
+                    "DBUS_SESSION_BUS_ADDRESS": bus_address,
+                },
+            )
+            properties = dict(
+                line.split("=", 1) for line in result.stdout.splitlines() if "=" in line
+            )
+            invocation = properties.get("InvocationID", "")
+            unit_group = properties.get("ControlGroup", "").rstrip("/")
+            # Read identity again after systemd lookup to reject PID reuse.
+            if (
+                result.returncode != 0
+                or properties.get("LoadState") != "loaded"
+                or properties.get("ActiveState") != "active"
+                or properties.get("MainPID") != str(peer_pid)
+                or len(invocation) != 32
+                or any(char not in "0123456789abcdef" for char in invocation)
+                or not unit_group.endswith("/" + _BROKER_UNIT)
+                or cgroup != unit_group
+                or _process_start_ticks(peer_pid) != start_ticks
+            ):
+                raise ValueError("broker unit identity mismatch")
+        except (OSError, ValueError, subprocess.SubprocessError) as exc:
+            raise AOSFault(ErrorCode.MODEL_FAILURE, "Shared GPU broker is not the pinned service") from exc
+
+    def _infer(
+        self,
+        profile_id: str,
+        deployment_digest: str,
+        payload: dict,
+    ) -> GpuInferenceResult:
+        if profile_id not in _PROFILE_IDS:
+            raise ValueError("unknown fixed AOS GPU turn profile")
+        if (len(deployment_digest) != 64 or
+                any(char not in "0123456789abcdef" for char in deployment_digest)):
+            raise ValueError("pinned deployment digest is required")
+        request_id = uuid4().hex
+        request = {
+            "version": 1,
+            "op": "infer",
+            "request_id": request_id,
+            "profile_id": profile_id,
+            "deployment_digest": deployment_digest,
+            "payload": payload,
+        }
+        encoded = (canonical(request) + "\n").encode("utf-8")
+        if len(encoded) > _MAX_FRAME_BYTES:
+            raise AOSFault(ErrorCode.INVALID_OUTPUT, "GPU model turn request exceeds protocol bound")
+        self._verify_socket()
+        deadline = time.monotonic() + self.timeout_seconds
+        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
+            connection.settimeout(max(0.001, deadline - time.monotonic()))
+            connection.connect(str(self.socket_path))
+            credentials = connection.getsockopt(
+                socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")
+            )
+            peer_pid, peer_uid, _peer_gid = struct.unpack("3i", credentials)
+            self._verify_broker_peer(peer_pid, peer_uid)
+            connection.settimeout(max(0.001, deadline - time.monotonic()))
+            connection.sendall(encoded)
+            data = bytearray()
+            while b"\n" not in data:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise TimeoutError("shared GPU broker response deadline expired")
+                connection.settimeout(remaining)
+                chunk = connection.recv(min(8192, _MAX_FRAME_BYTES + 1 - len(data)))
+                if not chunk:
+                    raise AOSFault(ErrorCode.MODEL_FAILURE, "Shared GPU broker closed an incomplete reply")
+                data.extend(chunk)
+                if len(data) > _MAX_FRAME_BYTES:
+                    raise AOSFault(ErrorCode.INVALID_OUTPUT, "Shared GPU broker response exceeds protocol bound")
+            line, separator, trailing = bytes(data).partition(b"\n")
+            if not separator or trailing:
+                raise AOSFault(ErrorCode.INVALID_OUTPUT, "Shared GPU broker returned multiple frames")
+        try:
+            receipt = _WireReceipt.model_validate_json(line, strict=True)
+        except ValidationError as exc:
+            raise AOSFault(ErrorCode.INVALID_OUTPUT, "Shared GPU broker receipt is malformed") from exc
+        if (
+            receipt.request_id != request_id
+            or receipt.profile_id != profile_id
+            or receipt.deployment_digest != deployment_digest
+        ):
+            raise AOSFault(ErrorCode.MODEL_FAILURE, "Shared GPU result is bound to another turn")
+        return GpuInferenceResult.model_validate_json(receipt.model_dump_json(), strict=True)
+
+    async def infer(
+        self,
+        profile_id: Literal[
+            "aos.decider.turn.v1",
+            "aos.bonsai.recovery.v1",
+            "aos.bonsai.vision.v1",
+        ],
+        deployment_digest: str,
+        payload: dict,
+    ) -> GpuInferenceResult:
+        """Submit one typed inference; broker owns queueing and all drain checks."""
+        try:
+            return await asyncio.to_thread(self._infer, profile_id, deployment_digest, payload)
+        except TimeoutError as exc:
+            raise AOSFault(ErrorCode.TIMEOUT, "Shared GPU model turn exceeded its bounded deadline") from exc
