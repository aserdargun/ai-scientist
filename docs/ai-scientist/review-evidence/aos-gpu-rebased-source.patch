+class DetachedLabControlPolicy:
+    """Deterministic host policy for status/stop/report; never invokes a model."""
+
+    identity = {
+        "deployment_id": "lab-control-policy-v1",
+        "kind": "host_policy",
+        "real_model": False,
+    }
+
+    async def decide(self, state: State, options: list[Option]) -> Prediction:
+        del state
+        return Prediction(
+            selected_option=options[0].id,
+            probabilities={option.id: 1.0 if index == 0 else 0.0 for index, option in enumerate(options)},
+        )
+
+
+class LabApiClient:
+    """Bounded localhost-only HTTP client; auth material never enters argv/logs."""
+
+    def __init__(self, base_url: str, token_file: Path, *, timeout_seconds: float = 3.0):
+        parsed = urlsplit(base_url)
+        try:
+            loopback = (
+                ipaddress.ip_address(parsed.hostname) if parsed.hostname is not None else None
+            )
+        except ValueError:
+            loopback = None
+        if (
+            parsed.scheme != "http"
+            or loopback is None
+            or not loopback.is_loopback
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.path not in {"", "/"}
+            or parsed.query
+            or parsed.fragment
+            or parsed.port is None
+            or not 0 < timeout_seconds <= 5
+        ):
+            raise ValueError("Lab API must be an explicitly configured bounded loopback endpoint")
+        descriptor = os.open(token_file, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
+        try:
+            info = os.fstat(descriptor)
+            if (
+                not stat.S_ISREG(info.st_mode)
+                or info.st_uid != os.getuid()
+                or info.st_mode & 0o077
+                or info.st_size > 4096
+            ):
+                raise ValueError("Lab API token file must be private, owned and regular")
+            with os.fdopen(os.dup(descriptor), "r", encoding="utf-8") as stream:
+                token = stream.read(4097).strip()
+        finally:
+            os.close(descriptor)
+        if not token or len(token) > 4096:
+            raise ValueError("Lab API token file is empty or oversized")
+        self.host = parsed.hostname
+        self.port = parsed.port
+        self.token = token
+        self.timeout_seconds = timeout_seconds
+
+    def start(self, request: LabStartRequest) -> LabRunHandle:
+        payload = self._request("POST", "/v1/runs", request.model_dump(mode="json"))
+        return LabRunHandle.model_validate_json(payload, strict=True)
+
+    def status(self, run_id: UUID) -> LabRunStatus:
+        payload = self._request("GET", f"/v1/runs/{run_id}")
+        status = LabRunStatus.model_validate_json(payload, strict=True)
+        if status.run_id != run_id:
+            raise ValueError("Lab status belongs to another run")
+        return status
+
+    def stop(self, run_id: UUID) -> LabRunStatus:
+        payload = self._request("POST", f"/v1/runs/{run_id}/stop", {})
+        status = LabRunStatus.model_validate_json(payload, strict=True)
+        if status.run_id != run_id:
+            raise ValueError("Lab stop response belongs to another run")
+        return status
+
+    def report(self, run_id: UUID) -> LabVerifiedReport:
+        # The real 80-score Director report is ~71 KiB. Keep ordinary control
+        # responses small while giving this typed payload a bounded 256 KiB
+        # ceiling; larger suites need pagination before this cap is raised.
+        payload = self._request("GET", f"/v1/runs/{run_id}/report", max_response_bytes=256 * 1024)
+        report = LabVerifiedReport.model_validate_json(payload, strict=True)
+        if report.run_id != run_id or report.report.get("run_id") != str(run_id):
+            raise ValueError("Lab report belongs to another run")
+        canonical_report = json.dumps(
+            report.report,
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+            allow_nan=False,
+        ).encode("utf-8")
+        if hashlib.sha256(canonical_report).hexdigest() != report.report_sha256:
+            raise ValueError("Lab report hash verification failed")
+        if report.report.get("status") not in {"completed", "stopped", "failed"}:
+            raise ValueError("Lab report is not terminal")
+        return report
+
+    def _request(
+        self,
+        method: str,
+        path: str,
+        payload: dict | None = None,
+        *,
+        max_response_bytes: int = 64 * 1024,
+    ) -> bytes:
+        body = (
+            None
+            if payload is None
+            else json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False).encode(
+                "utf-8"
+            )
+        )
+        connection = http.client.HTTPConnection(self.host, self.port, timeout=self.timeout_seconds)
+        try:
+            connection.request(
+                method,
+                path,
+                body=body,
+                headers={
+                    "Authorization": f"Bearer {self.token}",
+                    "Content-Type": "application/json",
+                    "Accept": "application/json",
+                },
+            )
+            response = connection.getresponse()
+            data = response.read(max_response_bytes + 1)
+            if len(data) > max_response_bytes:
+                raise RuntimeError("Lab API response exceeded its bounded payload limit")
+            if response.status not in {200, 202}:
+                raise RuntimeError("Lab API request was rejected")
+
+            def unique_pairs(pairs):
+                result = {}
+                for key, item in pairs:
+                    if key in result:
+                        raise ValueError("Duplicate response key")
+                    result[key] = item
+                return result
+
+            value = json.loads(
+                data,
+                object_pairs_hook=unique_pairs,
+                parse_constant=lambda _value: (_ for _ in ()).throw(ValueError("Non-finite JSON")),
+            )
+            if not isinstance(value, dict):
+                raise ValueError("Lab API response must be an object")
+            return data
+        finally:
+            connection.close()
+
+
+class LabExternalJobCoordinator:
+    """SQLite ledger + Lab transport with lease-bound, short control calls."""
+
+    def __init__(
+        self,
+        connection,
+        controller,
+        client: LabApiClient,
+        *,
+        allowed_suites: frozenset[str],
+        decision_engine=None,
+    ):
+        self.connection = connection
+        self.controller = controller
+        self.client = client
+        self.allowed_suites = allowed_suites
+        self.decision_engine = decision_engine or FixtureDecisionEngine()
+
+    def _validate_lab_action(self, action: Action, state: State) -> None:
+        ToolRegistry.validate(action)
+        SafetyPolicy.check(action, state, state.runtime_id)
+
+    async def _decision_material(self, action: Action, state: State) -> dict[str, object]:
+        engine = self.decision_engine if action.tool == "lab.start" else DetachedLabControlPolicy()
+        options = [
+            Option(id=action.selected_option, label=f"Perform bounded Lab {action.selected_option}"),
+            Option(id="deny", label="Do not perform the Lab action"),
+        ]
+        prediction = await engine.decide(state, options)
+        prediction.validate_options(options)
+        request = {**decision_request(state, options), "engine": engine.identity}
+        response = {
+            "engine": engine.identity,
+            "prediction": prediction.model_dump(mode="json"),
+        }
+        return {
+            "call_id": identifier("call"),
+            "deployment_id": str(engine.identity["deployment_id"]),
+            "request_json": canonical(request),
+            "response_json": canonical(response),
+            "options_json": canonical([option.model_dump(mode="json") for option in options]),
+            "probabilities_json": canonical(prediction.probabilities),
+            "selected_option": prediction.selected_option,
+            "confidence": max(prediction.probabilities.values()),
+        }
+
+    async def _record_control_action(
+        self,
+        row,
+        operation: Literal["status", "stop", "report"],
+        *,
+        idempotency_key: str | None = None,
+        require_human_lease: bool = False,
+    ) -> str:
+        desktop = self.controller.state()
+        binding = self.connection.execute(
+            "SELECT session_id,lease_id,generation FROM aos_external_job_bindings WHERE job_id=?",
+            (row["job_id"],),
+        ).fetchone()
+        if binding is None or binding["session_id"] != self.controller.session_id:
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab job is not bound to this AOS session")
+        if require_human_lease and (
+            desktop.get("owner") != "HUMAN"
+            or desktop.get("status") != "running"
+            or binding["lease_id"] != desktop.get("lease_id")
+            or binding["generation"] != desktop.get("generation")
+        ):
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab stop requires the current bound human lease")
+        if not row["lab_run_id"]:
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab control requires an acknowledged run handle")
+        stored = self.connection.execute(
+            "SELECT state_json FROM runtime_states WHERE run_id=?", (row["run_id"],)
+        ).fetchone()
+        if stored is None:
+            raise AOSFault(ErrorCode.INVALID_OUTPUT, "Lab AOS trajectory has no typed runtime state")
+        state = State.model_validate_json(stored["state_json"])
+        if (
+            state.task_kind != "ai_scientist"
+            or state.owner != "AGENT"
+            or (require_human_lease and state.runtime_id != desktop.get("runtime_id"))
+            or state.phase != Phase.EXECUTE
+        ):
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab action is not bound to the current typed AOS state")
+        request_key = idempotency_key or f"lab-{operation}:{row['job_id']}:{uuid4().hex}"
+        previous = self.connection.execute(
+            "SELECT a.action_id,a.status,a.arguments_json,e.envelope_json "
+            "FROM actions a JOIN action_envelopes e USING(action_id) "
+            "WHERE a.run_id=? AND a.idempotency_key=?",
+            (state.run_id, request_key),
+        ).fetchone()
+        if previous is not None:
+            envelope = Action.model_validate_json(previous["envelope_json"], strict=True)
+            if (
+                envelope.task_id != state.task_id
+                or envelope.run_id != state.run_id
+                or envelope.step_id != state.step_id
+                or envelope.tool != f"lab.{operation}"
+                or envelope.arguments != {"job_id": row["job_id"], "lab_run_id": row["lab_run_id"]}
+                or previous["arguments_json"]
+                != canonical({"job_id": row["job_id"], "lab_run_id": row["lab_run_id"]})
+            ):
+                raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab control idempotency key conflicts")
+            if previous["status"] == "ok":
+                return previous["action_id"]
+            if previous["status"] != "intent":
+                raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab control action is not retryable")
+            return previous["action_id"]
+        action_id = identifier("action")
+        action = Action(
+            task_id=state.task_id,
+            run_id=state.run_id,
+            step_id=state.step_id,
+            action_id=action_id,
+            runtime_id=state.runtime_id,
+            state_version=state.state_version,
+            owner_lease_id=state.owner_lease_id,
+            tool=f"lab.{operation}",
+            arguments={"job_id": row["job_id"], "lab_run_id": row["lab_run_id"]},
+            expected_effect=f"Perform one bounded Lab {operation} control operation.",
+            deadline=time.time() + 5.0,
+            idempotency_key=request_key,
+            selected_option=operation,
+        )
+        self._validate_lab_action(action, state)
+        decision = await self._decision_material(action, state)
+        if decision["selected_option"] != operation:
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Fixture decision denied the Lab control action")
+        timestamp = now()
+        decision_id = identifier("decision")
+        snapshot_id = identifier("snapshot")
+        with self.connection:
+            self.connection.execute(
+                "INSERT INTO model_calls(call_id,run_id,step_id,deployment_id,role,request_json,"
+                "response_json,status,created_at) VALUES(?,?,?,?, 'system1', ?,?,'ok',?)",
+                (
+                    decision["call_id"],
+                    state.run_id,
+                    state.step_id,
+                    decision["deployment_id"],
+                    decision["request_json"],
+                    decision["response_json"],
+                    timestamp,
+                ),
+            )
+            self.connection.execute(
+                "INSERT INTO state_snapshots(snapshot_id,run_id,step_id,state_version,state_json,content_sha256,created_at) "
+                "VALUES(?,?,?,?,?,?,?)",
+                (
+                    snapshot_id,
+                    state.run_id,
+                    state.step_id,
+                    state.state_version,
+                    state.model_dump_json(),
+                    digest(state.model_dump(mode="json")),
+                    timestamp,
+                ),
+            )
+            self.connection.execute(
+                "INSERT INTO decisions(decision_id,run_id,step_id,snapshot_id,call_id,question,"
+                "options_json,probabilities_json,selected_option,confidence,policy_result,created_at) "
+                "VALUES(?,?,?,?,?,?,?,?,?,?,'allow',?)",
+                (
+                    decision_id,
+                    state.run_id,
+                    state.step_id,
+                    snapshot_id,
+                    decision["call_id"],
+                    f"Authorize the bounded detached Lab {operation} action.",
+                    decision["options_json"],
+                    decision["probabilities_json"],
+                    decision["selected_option"],
+                    decision["confidence"],
+                    timestamp,
+                ),
+            )
+            self.connection.execute(
+                "INSERT INTO actions(action_id,run_id,step_id,decision_id,idempotency_key,tool,"
+                "arguments_json,status,created_at) VALUES(?,?,?,?,?,?,?,'intent',?)",
+                (
+                    action.action_id,
+                    action.run_id,
+                    action.step_id,
+                    decision_id,
+                    action.idempotency_key,
+                    action.tool,
+                    canonical(action.arguments),
+                    timestamp,
+                ),
+            )
+            self.connection.execute(
+                "INSERT INTO action_envelopes(action_id,envelope_json,payload_sha256) VALUES(?,?,?)",
+                (
+                    action.action_id,
+                    canonical(action.model_dump(mode="json")),
+                    digest(action.model_dump(mode="json")),
+                ),
+            )
+        return action_id
+
+    def _finish_control_action(self, action_id: str, result: dict[str, object]) -> None:
+        with self.connection:
+            changed = self.connection.execute(
+                "UPDATE actions SET status='ok',result_json=?,completed_at=? "
+                "WHERE action_id=? AND status='intent'",
+                (canonical(result), now(), action_id),
+            ).rowcount
+            if changed != 1:
+                existing = self.connection.execute(
+                    "SELECT status,result_json FROM actions WHERE action_id=?", (action_id,)
+                ).fetchone()
+                if existing is None or existing["status"] != "ok":
+                    raise AOSFault(ErrorCode.UI_CHANGED, "Lab action intent changed before completion")
+                prior = json.loads(existing["result_json"])
+                if prior.get("lab_run_id") != result.get("lab_run_id"):
+                    raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab action replay changed run identity")
+
+    def _bind_lab_handle(self, row, lab_run_id: UUID) -> None:
+        stored = self.connection.execute(
+            "SELECT state_json FROM runtime_states WHERE run_id=?", (row["run_id"],)
+        ).fetchone()
+        if stored is None:
+            raise AOSFault(ErrorCode.INVALID_OUTPUT, "Lab AOS trajectory has no typed runtime state")
+        state = State.model_validate_json(stored["state_json"])
+        try:
+            identity = json.loads(state.authorized_content)
+        except (TypeError, json.JSONDecodeError):
+            raise AOSFault(ErrorCode.INVALID_OUTPUT, "Lab AOS state identity is malformed") from None
+        if not isinstance(identity, dict) or identity.get("job_id") != row["job_id"]:
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab handle cannot bind to another AOS job")
+        existing = identity.get("lab_run_id")
+        if existing not in {None, str(lab_run_id)}:
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "AOS Lab run identity cannot be changed")
+        identity["lab_run_id"] = str(lab_run_id)
+        updated = state.model_copy(
+            update={"authorized_content": canonical(identity), "state_version": state.state_version + 1}
+        )
+        timestamp = now()
+        with self.connection:
+            changed = self.connection.execute(
+                "UPDATE runtime_states SET state_version=?,state_json=? WHERE run_id=? AND state_version=?",
+                (updated.state_version, updated.model_dump_json(), updated.run_id, state.state_version),
+            ).rowcount
+            if changed != 1:
+                raise AOSFault(ErrorCode.UI_CHANGED, "Lab state changed before handle binding")
+            self.connection.execute(
+                "UPDATE steps SET state='lab_handle_bound' WHERE step_id=? AND ended_at IS NULL",
+                (updated.step_id,),
+            )
+            self.connection.execute(
+                "INSERT INTO state_snapshots(snapshot_id,run_id,step_id,state_version,state_json,content_sha256,created_at) "
+                "VALUES(?,?,?,?,?,?,?)",
+                (
+                    identifier("snapshot"),
+                    updated.run_id,
+                    updated.step_id,
+                    updated.state_version,
+                    updated.model_dump_json(),
+                    digest(updated.model_dump(mode="json")),
+                    timestamp,
+                ),
+            )
+
+    async def start(self, session_id: str, request: AOSLabStartRequest) -> dict[str, object]:
+        self._check_lease(request.lease_id, request.generation)
