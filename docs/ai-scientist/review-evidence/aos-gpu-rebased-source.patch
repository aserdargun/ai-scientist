+-- Explicitly rebind an existing detached Lab handle after AOS process restart.
+-- This changes only the AOS control session; it never resubmits a Lab start.
+BEGIN IMMEDIATE;
+CREATE TABLE aos_external_job_bindings (
+    job_id TEXT PRIMARY KEY REFERENCES aos_external_jobs(job_id),
+    session_id TEXT NOT NULL REFERENCES desktop_sessions(session_id),
+    lease_id TEXT NOT NULL,
+    generation INTEGER NOT NULL CHECK(generation >= 0),
+    updated_at TEXT NOT NULL
+);
+INSERT INTO aos_external_job_bindings(job_id,session_id,lease_id,generation,updated_at)
+SELECT job_id,session_id,lease_id,generation,updated_at FROM aos_external_jobs;
+
+CREATE TABLE aos_external_job_binding_events (
+    event_id TEXT PRIMARY KEY,
+    job_id TEXT NOT NULL REFERENCES aos_external_jobs(job_id),
+    from_session_id TEXT NOT NULL REFERENCES desktop_sessions(session_id),
+    to_session_id TEXT NOT NULL REFERENCES desktop_sessions(session_id),
+    from_generation INTEGER NOT NULL CHECK(from_generation >= 0),
+    to_generation INTEGER NOT NULL CHECK(to_generation >= 0),
+    lease_id TEXT NOT NULL,
+    created_at TEXT NOT NULL,
+    CHECK(from_session_id != to_session_id OR from_generation != to_generation)
+);
+CREATE TRIGGER aos_external_job_binding_events_no_update
+BEFORE UPDATE ON aos_external_job_binding_events
+BEGIN SELECT RAISE(ABORT,'external job binding events are immutable'); END;
+CREATE TRIGGER aos_external_job_binding_events_no_delete
+BEFORE DELETE ON aos_external_job_binding_events
+BEGIN SELECT RAISE(ABORT,'external job binding events are immutable'); END;
+
+CREATE TRIGGER aos_external_job_binding_insert_guard
+BEFORE INSERT ON aos_external_job_bindings
+WHEN NOT EXISTS (
+    SELECT 1 FROM aos_external_jobs j
+    JOIN desktop_sessions s ON s.session_id=NEW.session_id
+    WHERE j.job_id=NEW.job_id AND j.session_id=NEW.session_id
+      AND j.lease_id=NEW.lease_id AND j.generation=NEW.generation
+      AND s.owner='HUMAN' AND s.status='running'
+      AND s.lease_id=NEW.lease_id AND s.generation=NEW.generation
+)
+BEGIN SELECT RAISE(ABORT,'external job binding must match its initial human lease'); END;
+
+CREATE TRIGGER aos_external_job_binding_update_guard
+BEFORE UPDATE ON aos_external_job_bindings
+WHEN NOT EXISTS (
+    SELECT 1 FROM aos_external_jobs j
+    JOIN runs r ON r.run_id=j.run_id
+    JOIN runtime_states rs ON rs.run_id=j.run_id
+    JOIN desktop_sessions s ON s.session_id=NEW.session_id
+    WHERE j.job_id=NEW.job_id
+      AND j.state IN ('dispatch_pending','queued','running','stop_requested')
+      AND r.status='paused'
+      AND json_extract(rs.state_json,'$.task_kind')='ai_scientist'
+      AND json_extract(rs.state_json,'$.phase')='PAUSED'
+      AND json_extract(rs.state_json,'$.owner')='PAUSED'
+      AND s.owner='HUMAN' AND s.status='running'
+      AND s.lease_id=NEW.lease_id AND s.generation=NEW.generation
+      AND EXISTS (
+          SELECT 1 FROM aos_external_job_binding_events e
+          WHERE e.job_id=OLD.job_id AND e.from_session_id=OLD.session_id
+            AND e.to_session_id=NEW.session_id AND e.from_generation=OLD.generation
+            AND e.to_generation=NEW.generation AND e.lease_id=NEW.lease_id
+      )
+)
+BEGIN SELECT RAISE(ABORT,'external job rebind requires paused typed work, fresh human lease and audit event'); END;
+INSERT INTO schema_migrations(version,name,applied_at)
+VALUES(19,'lab_external_job_rebinding',strftime('%Y-%m-%dT%H:%M:%fZ','now'));
+COMMIT;
