+            ),
+            external_task_id=task_id,
+            external_run_id=run_id,
+            external_action_id=action_id,
+        )
+        request_json = canonical(remote_request.model_dump(mode="json"))
+        request_sha = hashlib.sha256(request_json.encode("utf-8")).hexdigest()
+        if existing is not None and existing["request_sha256"] != request_sha:
+            raise AOSFault(
+                ErrorCode.UNSAFE_ACTION, "Lab idempotency key conflicts with another request"
+            )
+        if existing is None:
+            timestamp = now()
+            desktop = self.controller.state()
+            state = State(
+                task_kind="ai_scientist",
+                task_id=task_id,
+                run_id=run_id,
+                step_id=step_id,
+                runtime_id=desktop["runtime_id"],
+                deployment_id="lab-external-job-v1",
+                state_version=0,
+                phase=Phase.EXECUTE,
+                owner="AGENT",
+                owner_lease_id=identifier("lease"),
+                original_goal="Run an allowlisted detached research job and verify its final report.",
+                normalized_goal="Run the registered Lab suite under the caller's bounded budget.",
+                success_criteria=("A terminal Lab report is retrieved and its digest is verified.",),
+                authorized_path="aos://lab/external-job",
+                authorized_content=canonical(
+                    {
+                        "job_id": job_id,
+                        "suite": request.suite,
+                        "request_sha256": request_sha,
+                        "lab_run_id": None,
+                    }
+                ),
+                observation="Only short Lab control actions are executed in this AOS session.",
+            )
+            start_arguments = {
+                "job_id": job_id,
+                "suite": request.suite,
+                "request_sha256": request_sha,
+            }
+            decision_id = identifier("decision")
+            action = Action(
+                task_id=task_id,
+                run_id=run_id,
+                step_id=step_id,
+                action_id=action_id,
+                runtime_id=state.runtime_id,
+                state_version=state.state_version,
+                owner_lease_id=state.owner_lease_id,
+                tool="lab.start",
+                arguments=start_arguments,
+                expected_effect="Create or recover one queued detached Lab run.",
+                deadline=time.time() + 5.0,
+                idempotency_key=f"lab-start:{request.idempotency_key}",
+                selected_option="start",
+            )
+            self._validate_lab_action(action, state)
+            decision = await self._decision_material(action, state)
+            if decision["selected_option"] != "start":
+                raise AOSFault(ErrorCode.UNSAFE_ACTION, "Fixture decision denied the Lab start action")
+            with self.connection:
+                self.connection.execute(
+                    "INSERT INTO tasks(task_id,original_goal,normalized_goal,language,"
+                    "success_criteria_json,"
+                    "workspace_scope_json,created_at) VALUES(?,?,?,?,?,?,?)",
+                    (
+                        state.task_id,
+                        state.original_goal,
+                        state.normalized_goal,
+                        "en",
+                        canonical(state.success_criteria),
+                        canonical([state.authorized_path]),
+                        timestamp,
