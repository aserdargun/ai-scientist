+                observation="Only short Lab control actions are executed in this AOS session.",
+            )
+            start_arguments = {
+                "job_id": job_id,
+                "suite": request.suite,
+                "request_sha256": request_sha,
+            }
+            decision_id = identifier("decision")
+            action = Action(
+                task_id=task_id,
+                run_id=run_id,
+                step_id=step_id,
+                action_id=action_id,
+                runtime_id=state.runtime_id,
+                state_version=state.state_version,
+                owner_lease_id=state.owner_lease_id,
+                tool="lab.start",
