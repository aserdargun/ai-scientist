+        desktop = self.controller.state()
+        resumed = State.model_validate(
+            {
+                **paused.model_dump(),
+                "runtime_id": desktop["runtime_id"],
+                "state_version": paused.state_version + 1,
+                "phase": Phase.EXECUTE,
+                "owner": "AGENT",
+                "owner_lease_id": identifier("lease"),
+            }
+        )
+        timestamp = now()
+        with self.connection:
