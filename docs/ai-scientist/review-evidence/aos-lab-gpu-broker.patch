+"""One inference from the pinned Decider inside a broker-owned systemd unit."""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+from worker import ModelSession, verify_environment
+
+MAX_LINE = 65_536
+
+
+def _read_request() -> dict:
+    raw = sys.stdin.buffer.read(MAX_LINE + 1)
+    if not raw or len(raw) > MAX_LINE:
+        raise ValueError("broker Decider input exceeds bound")
+    value = json.loads(raw)
+    if not isinstance(value, dict) or set(value) != {"request"}:
+        raise ValueError("broker Decider input schema differs")
+    return value["request"]
+
+
+def _receipt(value: dict, path: Path) -> None:
+    encoded = json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    try:
+        with os.fdopen(descriptor, "wb", closefd=False) as stream:
+            stream.write(encoded)
+            stream.flush()
+            os.fsync(stream.fileno())
+    finally:
+        os.close(descriptor)
+
+
+def _wait_for_go(path: Path, expected: dict, timeout: float) -> None:
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        try:
+            info = path.lstat()
+            if info.st_uid != os.getuid() or info.st_size > 1024 or info.st_mode & 0o077:
+                raise ValueError("broker inference gate identity differs")
+            actual = json.loads(path.read_bytes())
+            if actual != expected:
+                raise ValueError("broker inference gate payload differs")
+            return
+        except FileNotFoundError:
+            time.sleep(0.025)
+    raise TimeoutError("broker inference gate was not opened")
+
+
+def main() -> int:
+    if len(sys.argv) != 3:
+        raise ValueError("Usage: broker_worker.py MANIFEST READY_FILE")
+    manifest_path = Path(sys.argv[1])
+    ready_path = Path(sys.argv[2])
+    request_id = os.environ["SWAPP_GPU_REQUEST_ID"]
+    profile_id = os.environ["SWAPP_GPU_PROFILE_ID"]
+    deployment_digest = os.environ["SWAPP_GPU_DEPLOYMENT_DIGEST"]
+    nonce = os.environ["SWAPP_GPU_TURN_NONCE"]
+    go_path = Path(os.environ["SWAPP_GPU_GO_FILE"])
+    activation_seconds = int(os.environ["SWAPP_GPU_ACTIVATION_SECONDS"])
+    pins = json.loads(manifest_path.read_text(encoding="utf-8"))
+    session = ModelSession(verify_environment(pins), pins)
+    session.manifest = manifest_path
+    readiness = session.prepare_gpu()
+    if readiness["deployment_digest"] != deployment_digest:
+        raise ValueError("Decider deployment digest differs from broker profile")
+    gate = {
+        "request_id": request_id,
+        "profile_id": profile_id,
+        "deployment_digest": deployment_digest,
+        "nonce": nonce,
+    }
+    _receipt(gate, ready_path)
+    _wait_for_go(go_path, gate, activation_seconds)
+    response = session.infer(_read_request())
+    if response.get("deployment_digest") != deployment_digest:
+        raise ValueError("Decider output deployment digest differs")
+    metrics = response.get("metrics")
+    if not isinstance(metrics, dict):
+        raise ValueError("Decider output metrics are malformed")
+    metrics["broker_activation_load_ms"] = readiness["load_ms"]
+    encoded = json.dumps(response, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+    if not encoded or len(encoded) > MAX_LINE:
+        raise ValueError("Decider output exceeds broker result limit")
+    sys.stdout.buffer.write(encoded)
+    sys.stdout.buffer.flush()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
