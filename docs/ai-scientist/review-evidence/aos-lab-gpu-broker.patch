+            self._validate_lab_action(action, state)
+            decision = await self._decision_material(action, state)
+            if decision["selected_option"] != "start":
+                raise AOSFault(ErrorCode.UNSAFE_ACTION, "Fixture decision denied the Lab start action")
+            with self.connection:
+                self.connection.execute(
+                    "INSERT INTO tasks(task_id,original_goal,normalized_goal,language,"
+                    "success_criteria_json,"
+                    "workspace_scope_json,created_at) VALUES(?,?,?,?,?,?,?)",
+                    (
