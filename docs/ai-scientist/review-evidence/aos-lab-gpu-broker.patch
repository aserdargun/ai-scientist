+BEGIN IMMEDIATE;
+CREATE TABLE aos_external_jobs (
+    job_id TEXT PRIMARY KEY,
+    task_id TEXT NOT NULL UNIQUE,
+    run_id TEXT NOT NULL UNIQUE,
+    action_id TEXT NOT NULL UNIQUE,
+    step_id TEXT NOT NULL UNIQUE,
+    session_id TEXT NOT NULL REFERENCES desktop_sessions(session_id),
+    lease_id TEXT NOT NULL,
+    generation INTEGER NOT NULL CHECK(generation >= 0),
+    idempotency_key TEXT NOT NULL,
+    remote_idempotency_key TEXT NOT NULL UNIQUE,
+    request_sha256 TEXT NOT NULL CHECK(length(request_sha256)=64),
+    request_json TEXT NOT NULL CHECK(json_valid(request_json)),
+    lab_run_id TEXT UNIQUE,
+    state TEXT NOT NULL CHECK(state IN ('dispatch_pending','queued','running','stop_requested',
+                                        'completed','stopped','failed')),
+    lab_state TEXT,
+    report_sha256 TEXT CHECK(report_sha256 IS NULL OR length(report_sha256)=64),
+    created_at TEXT NOT NULL,
+    updated_at TEXT NOT NULL,
+    UNIQUE(session_id,idempotency_key),
+    FOREIGN KEY(task_id) REFERENCES tasks(task_id),
+    FOREIGN KEY(run_id) REFERENCES runs(run_id),
+    FOREIGN KEY(action_id) REFERENCES actions(action_id),
+    FOREIGN KEY(run_id,step_id) REFERENCES steps(run_id,step_id)
+);
+CREATE TABLE aos_external_job_events (
+    event_id TEXT PRIMARY KEY,
+    job_id TEXT NOT NULL REFERENCES aos_external_jobs(job_id),
+    event_type TEXT NOT NULL CHECK(event_type IN ('dispatch_intent','accepted','status_observed',
+                                                   'stop_requested','report_verified','dispatch_error')),
+    event_json TEXT NOT NULL CHECK(json_valid(event_json)),
+    created_at TEXT NOT NULL
+);
+CREATE TRIGGER aos_external_job_events_no_update BEFORE UPDATE ON aos_external_job_events
+BEGIN SELECT RAISE(ABORT,'external job events are immutable'); END;
+CREATE TRIGGER aos_external_job_events_no_delete BEFORE DELETE ON aos_external_job_events
+BEGIN SELECT RAISE(ABORT,'external job events are immutable'); END;
+CREATE TRIGGER aos_external_job_identity_immutable BEFORE UPDATE OF
+    task_id,run_id,action_id,session_id,lease_id,generation,idempotency_key,request_sha256,request_json
+ON aos_external_jobs
+BEGIN SELECT RAISE(ABORT,'external job identity is immutable'); END;
+INSERT INTO schema_migrations(version,name,applied_at)
+VALUES(18,'lab_external_jobs',strftime('%Y-%m-%dT%H:%M:%fZ','now'));
+COMMIT;
