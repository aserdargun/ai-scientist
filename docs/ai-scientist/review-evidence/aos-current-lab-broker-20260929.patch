+    async def start(self, session_id: str, request: AOSLabStartRequest) -> dict[str, object]:
+        payload_sha = hashlib.sha256(canonical(request.model_dump(mode="json")).encode()).hexdigest()
+        key = (session_id, request.idempotency_key)
+        pending = self._inflight_start_requests.get(key)
+        if pending is not None:
+            if pending[0] != payload_sha:
+                raise AOSFault(
+                    ErrorCode.UNSAFE_ACTION, "Lab idempotency key conflicts with another request"
+                )
+            return await asyncio.shield(pending[1])
+        task = asyncio.create_task(self._start_once(session_id, request))
+        self._inflight_start_requests[key] = (payload_sha, task)
+        task.add_done_callback(
+            lambda done: self._forget_inflight_start(key, payload_sha, done)
+        )
+        return await asyncio.shield(task)
+
+    def _forget_inflight_start(
+        self,
+        key: tuple[str, str],
+        payload_sha: str,
+        task: asyncio.Task[dict[str, object]],
+    ) -> None:
+        current = self._inflight_start_requests.get(key)
+        if current is not None and current[0] == payload_sha and current[1] is task:
+            self._inflight_start_requests.pop(key, None)
+        if not task.cancelled():
+            task.exception()
