+        if dispatches:
+            timeout = min(6.0, max(1.0, float(getattr(self.client, "timeout_seconds", 3.0)) + 1.0))
+            try:
+                await asyncio.wait_for(
+                    asyncio.gather(
+                        *(asyncio.shield(dispatch) for dispatch in dispatches),
+                        return_exceptions=True,
+                    ),
+                    timeout=timeout,
