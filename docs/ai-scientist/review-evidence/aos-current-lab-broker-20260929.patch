+def test_invalid_opt_in_does_not_construct_runtime(monkeypatch, capsys, flags, message):
+    bootstrap = runpy.run_path(str(REPO_ROOT / 'scripts/serve_desktop.py'))
+    launch = Mock(side_effect=AssertionError('runtime must not launch'))
+    bootstrap['main'].__globals__['DesktopRuntime'] = launch
+    monkeypatch.setattr(sys, 'argv', ['serve_desktop', *flags])
+    with pytest.raises(SystemExit) as caught:
+        bootstrap['main']()
+    assert caught.value.code == 2
+    assert message in capsys.readouterr().err
+    launch.assert_not_called()
