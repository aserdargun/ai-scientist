+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "Lab handle cannot bind to another AOS job")
+        existing = identity.get("lab_run_id")
+        if existing not in {None, str(lab_run_id)}:
+            raise AOSFault(ErrorCode.UNSAFE_ACTION, "AOS Lab run identity cannot be changed")
+        identity["lab_run_id"] = str(lab_run_id)
