+        self._inflight_start_requests: dict[
+            tuple[str, str], tuple[str, asyncio.Task[dict[str, object]]]
+        ] = {}
+
+    def close_start_admission(self) -> None:
+        self._admission_closed = True
+
+    def open_start_admission(self) -> None:
+        self._admission_closed = False
+
+    def _active_job_count(self) -> int:
+        states = ",".join("?" for _ in _ACTIVE_LAB_JOB_STATES)
+        row = self.connection.execute(
+            f"SELECT count(*) AS count FROM aos_external_jobs WHERE state IN ({states})",
+            _ACTIVE_LAB_JOB_STATES,
+        ).fetchone()
+        return int(row["count"])
+
