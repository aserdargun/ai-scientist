+"""One bounded Bonsai completion using the fixed, manifest-pinned llama-server."""
+
+from __future__ import annotations
+
+import hashlib
+import http.client
+import json
+import os
+import secrets
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+MAX_BODY = 128 * 1024
+MAX_RESPONSE = 65_536
+
+
+def _sha(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        while chunk := stream.read(1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _verify_tree(root: Path, expected: dict[str, str]) -> None:
+    root = root.resolve(strict=True)
+    actual = {
+        path.relative_to(root).as_posix()
+        for path in root.rglob("*")
+        if path.is_file() and "__pycache__" not in path.parts and path.suffix != ".pyc"
+    }
+    if actual != set(expected):
+        raise ValueError("pinned Bonsai file set differs")
+    for relative, digest in expected.items():
+        relative_path = Path(relative)
+        if relative_path.is_absolute() or ".." in relative_path.parts:
+            raise ValueError("pinned Bonsai path is not relative to its artifact root")
+        path = root / relative
+        try:
+            resolved = path.resolve(strict=True)
+        except OSError as exc:
+            raise ValueError("pinned Bonsai artifact is missing or dangling") from exc
+        if not resolved.is_relative_to(root) or not resolved.is_file() or _sha(resolved) != digest:
+            raise ValueError("pinned Bonsai file digest differs")
+
+
+def _verify_manifest(pins: dict) -> None:
+    _verify_tree(Path(pins["model_path"]), pins["model_files"])
+    _verify_tree(Path(pins["runtime_path"]), pins["runtime_files"])
+    libraries = pins.get("native_libraries")
+    if not isinstance(libraries, dict) or not libraries:
+        raise ValueError("pinned Bonsai native-library list is required")
+    for filename, digest in libraries.items():
+        path = Path(filename)
+        if path.is_symlink() or not path.is_file() or _sha(path) != digest:
+            raise ValueError("pinned Bonsai native library digest differs")
+    server = Path(pins["server_path"])
+    if server.is_symlink() or not server.resolve(strict=True).is_relative_to(
+        Path(pins["runtime_path"]).resolve(strict=True)
+    ):
+        raise ValueError("Bonsai server is outside its pinned runtime")
+
+
+def _read_payload() -> dict:
+    raw = sys.stdin.buffer.read(MAX_BODY + 1)
+    if not raw or len(raw) > MAX_BODY:
+        raise ValueError("Bonsai broker input exceeds bound")
+    value = json.loads(raw)
+    if not isinstance(value, dict):
+        raise ValueError("Bonsai broker input must be an object")
+    return value
+
+
+def _http(port: int, token: str, route: str, body: dict | None, timeout: float) -> dict:
+    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
+    try:
+        encoded = (
+            None
+            if body is None
+            else json.dumps(body, sort_keys=True, separators=(",", ":"), allow_nan=False)
+        )
+        connection.request(
+            "GET" if body is None else "POST",
+            route,
+            body=encoded,
+            headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"},
+        )
+        response = connection.getresponse()
+        if response.status == 503:
+            raise ConnectionError("pinned Bonsai server is still loading")
+        data = response.read(MAX_RESPONSE + 1)
+        if response.status != 200 or len(data) > MAX_RESPONSE:
+            raise RuntimeError("pinned Bonsai server rejected or oversized the bounded request")
+        value = json.loads(data)
+        if not isinstance(value, dict):
+            raise RuntimeError("Bonsai response must be a JSON object")
+        return value
+    finally:
+        connection.close()
+
+
+def _write_ready(path: Path, value: dict) -> None:
+    encoded = json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    try:
+        with os.fdopen(descriptor, "wb", closefd=False) as stream:
+            stream.write(encoded)
+            stream.flush()
+            os.fsync(stream.fileno())
+    finally:
+        os.close(descriptor)
+
+
+def _wait_for_go(path: Path, expected: dict, timeout: float) -> None:
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        try:
+            info = path.lstat()
+            if info.st_uid != os.getuid() or info.st_size > 1024 or info.st_mode & 0o077:
+                raise ValueError("Bonsai inference gate identity differs")
+            if json.loads(path.read_bytes()) != expected:
+                raise ValueError("Bonsai inference gate payload differs")
+            return
+        except FileNotFoundError:
+            time.sleep(0.025)
+    raise TimeoutError("Bonsai inference gate was not opened")
+
+
+def main() -> int:
+    if len(sys.argv) != 4 or sys.argv[3] not in {"recovery", "vision"}:
+        raise ValueError("Usage: broker_worker.py MANIFEST READY_FILE recovery|vision")
+    manifest_path, ready_path = Path(sys.argv[1]), Path(sys.argv[2])
+    role = sys.argv[3]
+    pins = json.loads(manifest_path.read_text(encoding="utf-8"))
+    _verify_manifest(pins)
+    request = _read_payload()
+    request_id = os.environ["SWAPP_GPU_REQUEST_ID"]
+    profile_id = os.environ["SWAPP_GPU_PROFILE_ID"]
+    deployment_digest = os.environ["SWAPP_GPU_DEPLOYMENT_DIGEST"]
+    nonce = os.environ["SWAPP_GPU_TURN_NONCE"]
+    go_path = Path(os.environ["SWAPP_GPU_GO_FILE"])
+    activation_seconds = int(os.environ["SWAPP_GPU_ACTIVATION_SECONDS"])
+    alias = "bonsai-" + deployment_digest
+    if request.get("model") != alias:
+        raise ValueError("Bonsai request model alias differs from the fixed deployment")
+    if (
+        type(request.get("max_tokens")) is not int
+        or not 1 <= request["max_tokens"] <= pins["max_output_tokens"]
+    ):
+        raise ValueError("Bonsai output token cap differs from the pinned profile")
+    with socket.socket() as reservation:
+        reservation.bind(("127.0.0.1", 0))
+        port = reservation.getsockname()[1]
+    token = secrets.token_urlsafe(32)
+    server = Path(pins["server_path"])
+    model_root = Path(pins["model_path"])
+    work_root = Path(os.environ["TMPDIR"])
+    work_root.mkdir(mode=0o700, parents=True, exist_ok=True)
+    descriptor, key_name = tempfile.mkstemp(prefix="bonsai-key-", dir=work_root)
+    key_path = Path(key_name)
+    os.fchmod(descriptor, 0o600)
+    try:
+        with os.fdopen(descriptor, "w", encoding="ascii") as stream:
+            stream.write(token)
+            stream.flush()
+            os.fsync(stream.fileno())
+        command = [
+            str(server),
+            "--model",
+            str(model_root / pins["weights_file"]),
+            "--mmproj",
+            str(model_root / pins["projector_file"]),
+            "--host",
+            "127.0.0.1",
+            "--port",
+            str(port),
+            "--api-key-file",
+            str(key_path),
+            "--alias",
+            alias,
+            "--ctx-size",
+            str(pins["context_tokens"]),
+            "--parallel",
+            "1",
+            "--n-gpu-layers",
+            str(pins["gpu_layers"]),
+            "--flash-attn",
+            "on",
+            "--jinja",
+            "--reasoning-budget",
+            "0",
+            "--no-webui",
+            "--no-warmup",
+            "--no-context-shift",
+            "--log-disable",
+        ]
+        child = subprocess.Popen(
+            command,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            close_fds=True,
+        )
+        try:
+            deadline = time.monotonic() + activation_seconds
+            while time.monotonic() < deadline:
+                if child.poll() is not None:
+                    raise RuntimeError("pinned Bonsai server exited before readiness")
+                try:
+                    models = _http(port, token, "/v1/models", None, 1.0)
+                    if {item["id"] for item in models.get("data", [])} != {alias}:
+                        raise RuntimeError("Bonsai ready model alias differs")
+                    break
+                except (OSError, ConnectionError, TimeoutError):
+                    time.sleep(0.2)
+            else:
+                raise TimeoutError("Bonsai model readiness deadline expired")
+            gate = {
+                "request_id": request_id,
+                "profile_id": profile_id,
+                "deployment_digest": deployment_digest,
+                "nonce": nonce,
+            }
+            _write_ready(ready_path, gate)
+            _wait_for_go(go_path, gate, activation_seconds)
+            response = _http(port, token, "/v1/chat/completions", request, 58.0)
+            choices = response.get("choices")
+            if (
+                not isinstance(choices, list)
+                or len(choices) != 1
+                or choices[0].get("finish_reason") != "stop"
+            ):
+                raise RuntimeError("Bonsai completion is incomplete")
+            encoded = json.dumps(
+                response, sort_keys=True, separators=(",", ":"), allow_nan=False
+            ).encode()
+            if len(encoded) > MAX_RESPONSE:
+                raise RuntimeError("Bonsai completion exceeds broker response bound")
+            sys.stdout.buffer.write(encoded)
+            sys.stdout.buffer.flush()
+        finally:
+            if child.poll() is None:
+                child.terminate()
+                try:
+                    child.wait(timeout=8)
+                except subprocess.TimeoutExpired:
+                    child.kill()
+                    child.wait(timeout=2)
+    finally:
+        key_path.unlink(missing_ok=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
