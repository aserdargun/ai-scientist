+def test_control_authorization_revalidates_session_after_policy_await():
+    async def scenario():
+        db, controller, lab = _database(), FakeController(), FakeLabClient()
+        coordinator = LabExternalJobCoordinator(
+            db, controller, lab, allowed_suites=frozenset({"synthetic.allowed.v1"})
+        )
+        job = await coordinator.start("session-a", _request())
+        original = coordinator._decision_material
+        entered, release = asyncio.Event(), asyncio.Event()
+
+        async def delayed(tool, operation, state):
+            entered.set()
+            await release.wait()
+            return await original(tool, operation, state)
+
+        coordinator._decision_material = delayed
+        prior_status_calls = lab.status_calls
+        prior_status_actions = db.execute(
+            "SELECT count(*) FROM actions WHERE tool='lab.status'"
+        ).fetchone()[0]
+        status = asyncio.create_task(coordinator.status("session-a", str(job["job_id"])))
+        await entered.wait()
+        controller.session_id = "session-b"
+        release.set()
+        with pytest.raises(AOSFault):
+            await status
+        assert lab.status_calls == prior_status_calls
+        assert db.execute(
+            "SELECT count(*) FROM actions WHERE tool='lab.status'"
+        ).fetchone()[0] == prior_status_actions
+
+    asyncio.run(scenario())
+
+
+def test_repeated_status_authorization_uses_host_policy_without_model_calls():
+    async def scenario():
+        db, controller, lab = _database(), FakeController(), FakeLabClient()
+        engine = DelayedAllowDecisionEngine()
+        engine.release.set()
+        coordinator = LabExternalJobCoordinator(
+            db,
+            controller,
+            lab,
+            allowed_suites=frozenset({"synthetic.allowed.v1"}),
+            decision_engine=engine,
+        )
+        job = await coordinator.start("session-a", _request())
+        prior_status_calls = lab.status_calls
+        prior_control_decisions = db.execute(
+            "SELECT count(*) FROM decisions d JOIN model_calls m USING(call_id) "
+            "WHERE d.run_id=? AND m.deployment_id='lab-control-policy-v1'",
+            (job["aos_run_id"],),
+        ).fetchone()[0]
+        for _ in range(5):
+            observed = await coordinator.status("session-a", str(job["job_id"]))
+            assert observed["state"] == "queued"
+        assert engine.calls == 1
+        assert lab.status_calls == prior_status_calls + 5
+        controls = db.execute(
+            "SELECT count(*) FROM decisions d JOIN model_calls m USING(call_id) "
+            "WHERE d.run_id=? AND m.deployment_id='lab-control-policy-v1'",
+            (job["aos_run_id"],),
+        ).fetchone()[0]
+        assert controls == prior_control_decisions + 5
+
+    asyncio.run(scenario())
+
