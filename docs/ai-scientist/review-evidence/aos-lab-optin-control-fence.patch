+def test_control_authorization_revalidates_lease_after_policy_await():
+    async def scenario():
+        db, controller, lab = _database(), FakeController(), FakeLabClient()
+        coordinator = LabExternalJobCoordinator(
+            db, controller, lab, allowed_suites=frozenset({"synthetic.allowed.v1"})
+        )
+        job = await coordinator.start("session-a", _request())
+        original = coordinator._decision_material
+        entered, release = asyncio.Event(), asyncio.Event()
+
+        async def delayed(tool, operation, state):
+            entered.set()
+            await release.wait()
+            return await original(tool, operation, state)
+
+        coordinator._decision_material = delayed
+        stop = asyncio.create_task(
+            coordinator.stop("session-a", str(job["job_id"]), "lease-current", 3)
+        )
+        await entered.wait()
+        controller.current.update(owner="HUMAN", lease_id="lease-new", generation=4)
+        release.set()
+        with pytest.raises(AOSFault):
+            await stop
+        assert lab.state == "queued"
+        assert lab.stop_calls == 0
+        assert db.execute("SELECT count(*) FROM actions WHERE tool='lab.stop'").fetchone()[0] == 0
+
+    asyncio.run(scenario())
+
