+"""Opt-in AOS bridge for detached, typed Lab research jobs.
+
+This module is intentionally separate from DesktopScheduler: research runs are
+durable external jobs and never occupy its single foreground task slot.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import http.client
+import ipaddress
+import json
+import os
+import stat
+from pathlib import Path
+from typing import Literal
+from urllib.parse import urlsplit
+from uuid import UUID, uuid4
+
+from pydantic import BaseModel, ConfigDict, Field, StrictInt, StrictStr
+
+from .contracts import AOSFault, ErrorCode, canonical, identifier, now
+
+
+class LabBudget(BaseModel):
+    model_config = ConfigDict(strict=True, extra="forbid", frozen=True)
+
+    experiments: StrictInt = Field(ge=1, le=35)
+    wall_seconds: StrictInt = Field(ge=1, le=14_400)
+    model_tokens: StrictInt = Field(ge=0, le=350_000)
+
+
+class LabStartRequest(BaseModel):
+    model_config = ConfigDict(strict=True, extra="forbid", frozen=True)
+
+    idempotency_key: StrictStr = Field(min_length=16, max_length=128)
+    track: Literal["anomaly"] = "anomaly"
+    suite: StrictStr = Field(min_length=1, max_length=128)
+    budget: LabBudget
+    program_version: Literal["director.v1"] = "director.v1"
+    external_task_id: StrictStr = Field(pattern=r"^task-[0-9a-f]{32}$", max_length=37)
+    external_run_id: StrictStr = Field(pattern=r"^run-[0-9a-f]{32}$", max_length=36)
+    external_action_id: StrictStr = Field(pattern=r"^action-[0-9a-f]{32}$", max_length=39)
+
+
+class AOSLabStartRequest(BaseModel):
+    model_config = ConfigDict(strict=True, extra="forbid", frozen=True)
+
+    lease_id: StrictStr = Field(min_length=1, max_length=128)
+    generation: StrictInt = Field(ge=0)
+    idempotency_key: StrictStr = Field(min_length=16, max_length=128)
+    suite: StrictStr = Field(min_length=1, max_length=128)
+    experiments: StrictInt = Field(ge=1, le=35)
+    wall_seconds: StrictInt = Field(ge=1, le=14_400)
+    model_tokens: StrictInt = Field(ge=0, le=350_000)
+
+
+class AOSLabStopRequest(BaseModel):
+    model_config = ConfigDict(strict=True, extra="forbid", frozen=True)
+
+    lease_id: StrictStr = Field(min_length=1, max_length=128)
+    generation: StrictInt = Field(ge=0)
+
+
+class LabRunHandle(BaseModel):
+    model_config = ConfigDict(strict=True, extra="forbid", frozen=True)
+
+    run_id: UUID
+    state: Literal["queued", "running", "stop_requested", "completed", "stopped", "failed"]
+    reused: bool = False
+
+
+class LabRunStatus(BaseModel):
+    model_config = ConfigDict(strict=True, extra="forbid", frozen=True)
+
+    run_id: UUID
+    origin: Literal["aos"]
+    state: Literal["queued", "running", "stop_requested", "completed", "stopped", "failed"]
+    created_at: StrictStr
+    updated_at: StrictStr
+    stop_requested: bool
+    report_sha256: StrictStr | None = Field(default=None, pattern=r"^[0-9a-f]{64}$")
+
+
+class LabVerifiedReport(BaseModel):
+    model_config = ConfigDict(strict=True, extra="forbid", frozen=True)
+
+    run_id: UUID
+    report_sha256: StrictStr = Field(pattern=r"^[0-9a-f]{64}$")
+    report: dict[str, object]
+    verified_at: StrictStr
+
+
+class LabApiClient:
+    """Bounded localhost-only HTTP client; auth material never enters argv/logs."""
+
+    def __init__(self, base_url: str, token_file: Path, *, timeout_seconds: float = 3.0):
+        parsed = urlsplit(base_url)
+        try:
+            loopback = (
+                ipaddress.ip_address(parsed.hostname) if parsed.hostname is not None else None
+            )
+        except ValueError:
+            loopback = None
+        if (
+            parsed.scheme != "http"
+            or loopback is None
+            or not loopback.is_loopback
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.path not in {"", "/"}
+            or parsed.query
+            or parsed.fragment
+            or parsed.port is None
+            or not 0 < timeout_seconds <= 5
+        ):
+            raise ValueError("Lab API must be an explicitly configured bounded loopback endpoint")
+        descriptor = os.open(token_file, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
+        try:
+            info = os.fstat(descriptor)
+            if (
+                not stat.S_ISREG(info.st_mode)
+                or info.st_uid != os.getuid()
+                or info.st_mode & 0o077
+                or info.st_size > 4096
+            ):
+                raise ValueError("Lab API token file must be private, owned and regular")
+            with os.fdopen(os.dup(descriptor), "r", encoding="utf-8") as stream:
+                token = stream.read(4097).strip()
+        finally:
+            os.close(descriptor)
+        if not token or len(token) > 4096:
+            raise ValueError("Lab API token file is empty or oversized")
+        self.host = parsed.hostname
+        self.port = parsed.port
+        self.token = token
+        self.timeout_seconds = timeout_seconds
+
+    def start(self, request: LabStartRequest) -> LabRunHandle:
+        payload = self._request("POST", "/v1/runs", request.model_dump(mode="json"))
+        return LabRunHandle.model_validate_json(payload, strict=True)
+
+    def status(self, run_id: UUID) -> LabRunStatus:
+        payload = self._request("GET", f"/v1/runs/{run_id}")
+        status = LabRunStatus.model_validate_json(payload, strict=True)
+        if status.run_id != run_id:
+            raise ValueError("Lab status belongs to another run")
+        return status
+
+    def stop(self, run_id: UUID) -> LabRunStatus:
+        payload = self._request("POST", f"/v1/runs/{run_id}/stop", {})
+        status = LabRunStatus.model_validate_json(payload, strict=True)
+        if status.run_id != run_id:
+            raise ValueError("Lab stop response belongs to another run")
+        return status
+
+    def report(self, run_id: UUID) -> LabVerifiedReport:
+        # The real 80-score Director report is ~71 KiB. Keep ordinary control
+        # responses small while giving this typed payload a bounded 256 KiB
+        # ceiling; larger suites need pagination before this cap is raised.
+        payload = self._request("GET", f"/v1/runs/{run_id}/report", max_response_bytes=256 * 1024)
+        report = LabVerifiedReport.model_validate_json(payload, strict=True)
+        if report.run_id != run_id or report.report.get("run_id") != str(run_id):
+            raise ValueError("Lab report belongs to another run")
+        canonical_report = json.dumps(
+            report.report,
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+            allow_nan=False,
+        ).encode("utf-8")
+        if hashlib.sha256(canonical_report).hexdigest() != report.report_sha256:
+            raise ValueError("Lab report hash verification failed")
+        if report.report.get("status") not in {"completed", "stopped", "failed"}:
+            raise ValueError("Lab report is not terminal")
+        return report
+
+    def _request(
+        self,
+        method: str,
+        path: str,
+        payload: dict | None = None,
+        *,
+        max_response_bytes: int = 64 * 1024,
+    ) -> bytes:
+        body = (
+            None
+            if payload is None
+            else json.dumps(payload, sort_keys=True, separators=(",", ":"), allow_nan=False).encode(
+                "utf-8"
+            )
+        )
+        connection = http.client.HTTPConnection(self.host, self.port, timeout=self.timeout_seconds)
+        try:
+            connection.request(
+                method,
+                path,
+                body=body,
+                headers={
+                    "Authorization": f"Bearer {self.token}",
+                    "Content-Type": "application/json",
+                    "Accept": "application/json",
+                },
+            )
+            response = connection.getresponse()
+            data = response.read(max_response_bytes + 1)
+            if len(data) > max_response_bytes:
+                raise RuntimeError("Lab API response exceeded its bounded payload limit")
+            if response.status not in {200, 202}:
+                raise RuntimeError("Lab API request was rejected")
+
+            def unique_pairs(pairs):
+                result = {}
+                for key, item in pairs:
+                    if key in result:
+                        raise ValueError("Duplicate response key")
+                    result[key] = item
+                return result
+
+            value = json.loads(
+                data,
+                object_pairs_hook=unique_pairs,
+                parse_constant=lambda _value: (_ for _ in ()).throw(ValueError("Non-finite JSON")),
+            )
+            if not isinstance(value, dict):
+                raise ValueError("Lab API response must be an object")
+            return data
+        finally:
+            connection.close()
+
+
+class LabExternalJobCoordinator:
+    """SQLite ledger + Lab transport with lease-bound, short control calls."""
+
+    def __init__(
+        self, connection, controller, client: LabApiClient, *, allowed_suites: frozenset[str]
+    ):
+        self.connection = connection
+        self.controller = controller
+        self.client = client
+        self.allowed_suites = allowed_suites
+
+    async def start(self, session_id: str, request: AOSLabStartRequest) -> dict[str, object]:
+        self._check_lease(request.lease_id, request.generation)
+        if request.suite not in self.allowed_suites:
+            raise AOSFault(
+                ErrorCode.UNSAFE_ACTION, "Lab suite is outside the configured AOS allowlist"
+            )
+        existing = self.connection.execute(
+            "SELECT * FROM aos_external_jobs WHERE session_id=? AND idempotency_key=?",
+            (session_id, request.idempotency_key),
+        ).fetchone()
+        if existing is None:
+            job_id = identifier("external-job")
+            task_id = identifier("task")
+            run_id = identifier("run")
+            action_id = identifier("action")
+            step_id = identifier("step")
+        else:
+            job_id = existing["job_id"]
+            task_id = existing["task_id"]
+            run_id = existing["run_id"]
+            action_id = existing["action_id"]
+            step_id = existing["step_id"]
+        remote_idempotency_key = (
+            "aos-"
+            + hashlib.sha256(
+                f"{session_id}\0{task_id}\0{run_id}\0{action_id}\0{request.idempotency_key}".encode()
+            ).hexdigest()
+        )
+        remote_request = LabStartRequest(
+            idempotency_key=remote_idempotency_key,
+            suite=request.suite,
+            budget=LabBudget(
+                experiments=request.experiments,
+                wall_seconds=request.wall_seconds,
+                model_tokens=request.model_tokens,
+            ),
+            external_task_id=task_id,
