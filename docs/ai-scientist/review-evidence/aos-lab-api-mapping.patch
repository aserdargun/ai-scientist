+def test_delayed_running_status_cannot_regress_verified_terminal_state():
+    db, controller, lab = _database(), FakeController(), FakeLabClient()
+    coordinator = LabExternalJobCoordinator(
+        db, controller, lab, allowed_suites=frozenset({"synthetic.allowed.v1"})
+    )
+    job = asyncio.run(coordinator.start("session-a", _request()))
+    stale_started = threading.Event()
+    release_stale = threading.Event()
+    original_status = lab.status
+
+    def racing_status(run_id):
+        if threading.current_thread().name.startswith("asyncio_") and not stale_started.is_set():
+            stale_started.set()
+            assert release_stale.wait(timeout=3)
+            return LabRunStatus(
+                run_id=run_id,
+                origin="aos",
+                state="running",
+                created_at="2026-09-24T00:00:00Z",
+                updated_at="2026-09-24T00:01:00Z",
+                stop_requested=False,
+            )
+        return original_status(run_id)
+
+    lab.status = racing_status
+    lab.state = "completed"
+    report = {"run_id": str(lab.run_id), "status": "completed", "task_scores": []}
+    digest = hashlib.sha256(
+        json.dumps(report, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
+    ).hexdigest()
+    lab.report_document = LabVerifiedReport(
+        run_id=lab.run_id,
+        report_sha256=digest,
+        report=report,
+        verified_at="2026-09-24T00:02:00Z",
+    )
+
+    async def race():
+        stale_task = asyncio.create_task(coordinator.status("session-a", str(job["job_id"])))
+        assert await asyncio.to_thread(stale_started.wait, 3)
+        # The first request is blocked in its worker thread; AOS SQLite work
+        # remains serialized on this owning event-loop thread.
+        completed_result = await coordinator.status("session-a", str(job["job_id"]))
+        release_stale.set()
+        await stale_task
+        return completed_result
+
+    completed = asyncio.run(race())
+    final = db.execute(
+        "SELECT state,report_sha256 FROM aos_external_jobs WHERE job_id=?", (job["job_id"],)
+    ).fetchone()
+    assert completed["state"] == "completed"
+    assert tuple(final) == ("completed", digest)
+    assert db.execute("SELECT status FROM runs").fetchone()[0] == "succeeded"
+
