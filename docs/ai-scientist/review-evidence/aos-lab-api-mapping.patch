+class FakeController:
+    def __init__(self):
+        self.owner_thread = threading.get_ident()
+        self.session_id = "session-a"
+        self.current = {
+            "status": "running",
+            "owner": "HUMAN",
+            "lease_id": "lease-current",
+            "generation": 3,
+        }
+
+    def state(self):
+        assert threading.get_ident() == self.owner_thread
+        return dict(self.current)
+
+
+class FakeLabClient:
+    def __init__(self):
+        self.start_calls = []
+        self.run_id = uuid4()
+        self.state = "queued"
+        self.report_document = None
+
+    def start(self, request):
+        self.start_calls.append(request)
+        if len(self.start_calls) > 1:
+            self.run_id = uuid4()
+        return LabRunHandle(run_id=self.run_id, state=self.state, reused=len(self.start_calls) > 1)
+
+    def status(self, run_id):
+        assert run_id == self.run_id
+        report_sha256 = None
+        if self.report_document is not None:
+            report_sha256 = self.report_document.report_sha256
+        return LabRunStatus(
+            run_id=run_id,
+            origin="aos",
+            state=self.state,
+            created_at="2026-09-24T00:00:00Z",
+            updated_at="2026-09-24T00:01:00Z",
+            stop_requested=self.state == "stop_requested",
+            report_sha256=report_sha256,
+        )
+
+    def stop(self, run_id):
+        assert run_id == self.run_id
+        self.state = "stop_requested"
+        return self.status(run_id)
+
+    def report(self, run_id):
+        assert run_id == self.run_id and self.report_document is not None
+        return self.report_document
+
+
+def _database():
+    connection = sqlite3.connect(":memory:")
+    connection.row_factory = sqlite3.Row
+    connection.execute("PRAGMA foreign_keys=ON")
+    migrations = Path(__file__).resolve().parents[1] / "database/migrations"
+    for migration in sorted(migrations.glob("*.sql")):
+        connection.executescript(migration.read_text(encoding="utf-8"))
+    created = "2026-09-24T00:00:00Z"
+    for session_id in ("session-a", "session-b"):
+        connection.execute(
+            "INSERT INTO desktop_sessions VALUES(?,?,?,?,?,?,?,?,?)",
+            (
+                session_id,
+                "runtime",
+                "image",
+                "HUMAN",
+                "lease-current",
+                3,
+                "running",
+                created,
+                created,
+            ),
+        )
+    return connection
