+    verifier = _TrainingDrainVerifier(FakeGpu(), FakeUnits())  # type: ignore[arg-type]
+    monkeypatch.setattr("lab.training.worker._process_identity_alive", lambda _: False)
+    monkeypatch.setattr(
+        "lab.training.worker._unit_properties",
+        lambda _: {
