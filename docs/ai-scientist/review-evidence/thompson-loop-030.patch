+        proposal_limit=35,
+        wall_limit=100,
+        token_limit=1000,
+        snapshot=BudgetSnapshot(wall_seconds=11.0, model_tokens=500),
+    )
+    replayed, _ = loop._preserve_pending_strategy_after_failure(failed, ordinal=1)
+    assert replayed == failed
+    assert lease.append_count == first_append_count
+
