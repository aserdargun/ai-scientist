{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "diagnosis": {
      "maxLength": 600,
      "minLength": 1,
      "title": "Diagnosis",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "title": "Assumptions",
      "type": "array"
    },
    "revised_plan": {
      "anyOf": [
        {
          "const": []
        },
        {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "additionalProperties": false,
              "properties": {
                "order": {
                  "const": 1
                },
                "action": {
                  "const": "observe_workspace"
                },
                "expected_result": {
                  "maxLength": 300,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "order",
                "action",
                "expected_result"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "order": {
                  "const": 2
                },
                "action": {
                  "const": "create_authorized_file"
                },
                "expected_result": {
                  "maxLength": 300,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "order",
                "action",
                "expected_result"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "order": {
                  "const": 3
                },
                "action": {
                  "const": "verify_exact_content"
                },
                "expected_result": {
                  "maxLength": 300,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "order",
                "action",
                "expected_result"
              ],
              "type": "object"
            }
          ],
          "type": "array"
        }
      ],
      "maxItems": 3,
      "title": "Revised Plan",
      "type": "array"
    },
    "verification_criteria": {
      "items": {
        "const": "exact_file_content",
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Verification Criteria",
      "type": "array"
    },
    "needs_human": {
      "title": "Needs Human",
      "type": "boolean"
    }
  },
  "required": [
    "diagnosis",
    "evidence_refs",
    "assumptions",
    "revised_plan",
    "verification_criteria",
    "needs_human"
  ],
  "title": "RecoveryPlan",
  "type": "object"
}
