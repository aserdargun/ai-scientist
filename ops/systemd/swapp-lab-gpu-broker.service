[Unit]
Description=SWAPP AI Scientist authenticated AOS GPU broker
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/ai-scientist
EnvironmentFile=%h/.config/swapp-ai-scientist/aos-gpu-broker.env
Environment=SWAPP_GPU_STATE_DIR=%h/.local/state/swapp-gpu
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=BLIS_NUM_THREADS=1
RuntimeDirectory=swapp-gpu
RuntimeDirectoryMode=0700
StateDirectory=swapp-gpu
StateDirectoryMode=0700
UMask=0077
ExecStart=%h/ai-scientist/.venv/bin/lab-aos-gpu-broker
Restart=on-failure
RestartSec=5
MemoryMax=512M
MemorySwapMax=0
CPUQuota=100%
TasksMax=32
OOMPolicy=stop
KillMode=control-group
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/state/swapp-gpu /run/user/%U/swapp-gpu
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
