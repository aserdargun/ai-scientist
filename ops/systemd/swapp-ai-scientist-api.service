[Unit]
Description=SWAPP AI Scientist loopback control API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/ai-scientist
EnvironmentFile=%h/.config/swapp-ai-scientist/lab-api.env
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=BLIS_NUM_THREADS=1
ExecStart=%h/ai-scientist/.venv/bin/lab api serve --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=3
MemoryMax=1G
MemorySwapMax=0
CPUQuota=100%
TasksMax=32
OOMPolicy=stop
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/ai-scientist/data/runtime
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
